        root.insert(b"info".to_vec(), BencodeValue::Dict(info));

        let torrent = encode(&BencodeValue::Dict(root));
        let result = parse(&torrent);

        assert!(matches!(result, Err(MetainfoError::InvalidMultiFile(_))));
        if let Err(MetainfoError::InvalidMultiFile(msg)) = result {
            assert!(msg.contains("not a dictionary"), "msg: {}", msg);
        }
    }

    #[test]
    fn reject_multi_file_negative_length() {
        // File with negative length should be rejected
        let pieces = [0u8; 20];
        let files: &[(i64, &[&str])] = &[(-100, &["file.txt"])];
        let torrent = make_multi_file_torrent(
            "http://example.com/announce",
            "test",
            files,
            16384,
            &pieces,
        );

        let result = parse(&torrent);
        assert!(matches!(result, Err(MetainfoError::InvalidMultiFile(_))));
        if let Err(MetainfoError::InvalidMultiFile(msg)) = result {
            assert!(msg.contains("negative"), "msg: {}", msg);
        }
    }

    #[test]
    fn reject_multi_file_non_string_path_component() {
        // Path component that is not a byte string should be rejected
        use crate::bencode::encode;

        let mut file_entry = BTreeMap::new();
        file_entry.insert(b"length".to_vec(), BencodeValue::Integer(100));
        // Path contains an integer instead of byte string
        file_entry.insert(
            b"path".to_vec(),
            BencodeValue::List(vec![BencodeValue::Integer(42)]),
        );

        let mut info = BTreeMap::new();
        info.insert(b"files".to_vec(), BencodeValue::List(vec![BencodeValue::Dict(file_entry)]));
        info.insert(b"name".to_vec(), BencodeValue::Bytes(b"test".to_vec()));
        info.insert(b"piece length".to_vec(), BencodeValue::Integer(16384));
        info.insert(b"pieces".to_vec(), BencodeValue::Bytes(vec![0u8; 20]));

        let mut root = BTreeMap::new();
        root.insert(b"announce".to_vec(), BencodeValue::Bytes(b"http://example.com".to_vec()));
        root.insert(b"info".to_vec(), BencodeValue::Dict(info));

        let torrent = encode(&BencodeValue::Dict(root));
        let result = parse(&torrent);

        assert!(matches!(result, Err(MetainfoError::InvalidMultiFile(_))));
        if let Err(MetainfoError::InvalidMultiFile(msg)) = result {
            assert!(msg.contains("not a byte string"), "msg: {}", msg);
        }
    }

    #[test]
    fn reject_torrent_missing_length_and_files() {
        // Torrent with neither length nor files should be rejected
        use crate::bencode::encode;

        let mut info = BTreeMap::new();
        // Neither length nor files!
        info.insert(b"name".to_vec(), BencodeValue::Bytes(b"test".to_vec()));
        info.insert(b"piece length".to_vec(), BencodeValue::Integer(16384));
        info.insert(b"pieces".to_vec(), BencodeValue::Bytes(vec![0u8; 20]));

        let mut root = BTreeMap::new();
        root.insert(b"announce".to_vec(), BencodeValue::Bytes(b"http://example.com".to_vec()));
        root.insert(b"info".to_vec(), BencodeValue::Dict(info));

        let torrent = encode(&BencodeValue::Dict(root));
        let result = parse(&torrent);

        assert!(matches!(result, Err(MetainfoError::MissingField(_))));
        if let Err(MetainfoError::MissingField(field)) = result {
            assert!(field.contains("length") || field.contains("files"), "field: {}", field);
        }
    }

    #[test]
    fn multi_file_total_length_computed_correctly() {
        // Verify total_length is the sum of all file lengths
        let pieces = [0u8; 20];
        let files: &[(i64, &[&str])] = &[
            (1_000_000, &["a.bin"]),
            (2_000_000, &["b.bin"]),
            (3_000_000, &["c.bin"]),
            (4_000_000, &["d.bin"]),
        ];
        let torrent = make_multi_file_torrent(
            "http://example.com/announce",
            "data",
            files,
            262144,
            &pieces,
        );

        let metainfo = parse(&torrent).expect("should parse");
        assert_eq!(metainfo.total_length, 10_000_000);
    }
}
@

The tests use a helper function [[make\_single\_file\_torrent]] to construct valid
bencoded data. This approach is cleaner than writing raw bencode bytes and less
error-prone. We test both the happy path and various error conditions to ensure
robust error handling.
