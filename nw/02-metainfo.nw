        assert_eq!(metainfo.files.len(), 1, "should be single-file torrent");
    }

    // ========================================
    // Multi-File Torrent Parsing Tests
    // ========================================

    /// Helper to create a minimal valid multi-file torrent in bencode format.
    ///
    /// The structure is:
    /// ```text
    /// d
    ///   8:announce <url>
    ///   4:info d
    ///     5:files l
    ///       d 6:length <bytes> 4:path l <components> e e
    ///       ...
    ///     e
    ///     4:name <directory name>
    ///     12:piece length <bytes per piece>
    ///     6:pieces <20 * N bytes of hashes>
    ///   e
    /// e
    /// ```
    fn make_multi_file_torrent(
        announce: &str,
        name: &str,
        files: &[(i64, &[&str])], // (length, path components)
        piece_length: i64,
        pieces: &[u8],
    ) -> Vec<u8> {
        use crate::bencode::encode;

        // Build files list
        let mut files_list = Vec::new();
        for (length, path_components) in files {
            let mut file_entry = BTreeMap::new();
            file_entry.insert(b"length".to_vec(), BencodeValue::Integer(*length));

            let path_list: Vec<BencodeValue> = path_components
                .iter()
                .map(|s| BencodeValue::Bytes(s.as_bytes().to_vec()))
                .collect();
            file_entry.insert(b"path".to_vec(), BencodeValue::List(path_list));

            files_list.push(BencodeValue::Dict(file_entry));
        }

        let mut info = BTreeMap::new();
        info.insert(b"files".to_vec(), BencodeValue::List(files_list));
        info.insert(b"name".to_vec(), BencodeValue::Bytes(name.as_bytes().to_vec()));
        info.insert(
            b"piece length".to_vec(),
            BencodeValue::Integer(piece_length),
        );
        info.insert(b"pieces".to_vec(), BencodeValue::Bytes(pieces.to_vec()));

        let mut root = BTreeMap::new();
        root.insert(
            b"announce".to_vec(),
            BencodeValue::Bytes(announce.as_bytes().to_vec()),
        );
        root.insert(b"info".to_vec(), BencodeValue::Dict(info));

        encode(&BencodeValue::Dict(root))
    }

    #[test]
    fn parse_multi_file_torrent_single_file() {
        // Multi-file torrent with a single file entry
        let pieces = [0u8; 20];
        let files: &[(i64, &[&str])] = &[(1024, &["file.txt"])];
        let torrent = make_multi_file_torrent(
            "http://tracker.example.com/announce",
            "mydir",
            files,
            16384,
            &pieces,
        );

        let metainfo = parse(&torrent).expect("should parse multi-file torrent");

        assert_eq!(metainfo.announce, "http://tracker.example.com/announce");
        assert_eq!(metainfo.name, "mydir");
        assert_eq!(metainfo.total_length, 1024);
        assert_eq!(metainfo.files.len(), 1);
        assert_eq!(metainfo.files[0].length, 1024);
        assert_eq!(metainfo.files[0].path, PathBuf::from("mydir/file.txt"));
    }

    #[test]
    fn parse_multi_file_torrent_multiple_files() {
        // Multi-file torrent with multiple file entries
        let pieces = [0u8; 20];
        let files: &[(i64, &[&str])] = &[
            (1000, &["file1.txt"]),
            (2000, &["file2.txt"]),
            (3000, &["file3.txt"]),
        ];
        let torrent = make_multi_file_torrent(
            "http://example.com/announce",
            "bundle",
            files,
            16384,
            &pieces,
        );

        let metainfo = parse(&torrent).expect("should parse");

        assert_eq!(metainfo.name, "bundle");
        assert_eq!(metainfo.total_length, 6000); // 1000 + 2000 + 3000
        assert_eq!(metainfo.files.len(), 3);
        assert_eq!(metainfo.files[0].length, 1000);
        assert_eq!(metainfo.files[0].path, PathBuf::from("bundle/file1.txt"));
        assert_eq!(metainfo.files[1].length, 2000);
        assert_eq!(metainfo.files[1].path, PathBuf::from("bundle/file2.txt"));
        assert_eq!(metainfo.files[2].length, 3000);
        assert_eq!(metainfo.files[2].path, PathBuf::from("bundle/file3.txt"));
    }

    #[test]
    fn parse_multi_file_torrent_nested_directories() {
        // Multi-file torrent with nested directory structure
        let pieces = [0u8; 20];
        let files: &[(i64, &[&str])] = &[
            (100, &["subdir", "nested", "deep.txt"]),
            (200, &["other", "file.dat"]),
            (300, &["root.txt"]),
        ];
        let torrent = make_multi_file_torrent(
            "http://example.com/announce",
            "project",
            files,
            16384,
            &pieces,
        );

        let metainfo = parse(&torrent).expect("should parse nested directories");

        assert_eq!(metainfo.files.len(), 3);
        assert_eq!(
            metainfo.files[0].path,
            PathBuf::from("project/subdir/nested/deep.txt")
        );
        assert_eq!(
            metainfo.files[1].path,
            PathBuf::from("project/other/file.dat")
        );
        assert_eq!(metainfo.files[2].path, PathBuf::from("project/root.txt"));
        assert_eq!(metainfo.total_length, 600);
    }

    #[test]
    fn reject_multi_file_empty_files_array() {
        // Empty files array should be rejected
        let pieces = [0u8; 20];
        let files: &[(i64, &[&str])] = &[];
        let torrent = make_multi_file_torrent(
            "http://example.com/announce",
            "empty",
            files,
            16384,
            &pieces,
        );

        let result = parse(&torrent);
        assert!(matches!(result, Err(MetainfoError::InvalidMultiFile(_))));
        if let Err(MetainfoError::InvalidMultiFile(msg)) = result {
            assert!(msg.contains("empty"), "msg: {}", msg);
        }
    }

