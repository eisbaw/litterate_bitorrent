    /// Integration test with real ubuntu.torrent file.
    ///
    /// This test serves as the Phase 1 exit criteria validation:
    /// - Loads a real torrent file from the fixtures directory
    /// - Decodes the bencode successfully
    /// - Parses Metainfo from the bencoded dictionary
    /// - Prints info hash, piece count, and total size for verification
    /// - Asserts all values match known correct values
    ///
    /// Expected values from tests/fixtures/ubuntu.torrent.expected:
    /// - INFO_HASH=a1dfefec1a9dd7fa8a041ebeeea271db55126d2f
    /// - PIECE_COUNT=12602
    /// - TOTAL_LENGTH=3303444480
    #[test]
    fn integration_test_ubuntu_torrent() {
        // Step 1: Verify the fixture file exists
        let torrent_path = "tests/fixtures/ubuntu.torrent";
        assert!(
            std::path::Path::new(torrent_path).exists(),
            "ubuntu.torrent fixture should exist at {}",
            torrent_path
        );

        // Step 2: Read and decode the torrent file
        let torrent_bytes = std::fs::read(torrent_path)
            .expect("should read ubuntu.torrent file");

        // Step 3: Parse Metainfo from bencoded dict
        let metainfo = parse(&torrent_bytes)
            .expect("should parse ubuntu.torrent successfully");

        // Step 4: Print info hash in hex format
        let info_hash_hex = hex_string(&metainfo.info_hash);
        println!();
        println!("=== Phase 1 Exit Criteria: ubuntu.torrent ===");
        println!("Torrent name:     {}", metainfo.name);
        println!("Info hash:        {}", info_hash_hex);

        // Step 5: Print piece count
        let piece_count = metainfo.piece_hashes.len();
        println!("Piece count:      {}", piece_count);
        println!("Piece length:     {} bytes", metainfo.piece_length);

        // Step 6: Print total size in bytes and human-readable format
        println!(
            "Total size:       {} bytes ({})",
            metainfo.total_length,
            human_readable_size(metainfo.total_length)
        );
        println!("==============================================");
        println!();

        // Step 7: Assert all values match known correct values
        let expected_info_hash = "a1dfefec1a9dd7fa8a041ebeeea271db55126d2f";
        let expected_piece_count = 12602;
        let expected_total_length: u64 = 3303444480;

        assert_eq!(
            info_hash_hex, expected_info_hash,
            "info hash mismatch:\n  computed: {}\n  expected: {}",
            info_hash_hex, expected_info_hash
        );

        assert_eq!(
            piece_count, expected_piece_count,
            "piece count mismatch:\n  computed: {}\n  expected: {}",
            piece_count, expected_piece_count
        );

        assert_eq!(
            metainfo.total_length, expected_total_length,
            "total length mismatch:\n  computed: {}\n  expected: {}",
            metainfo.total_length, expected_total_length
        );

        // Additional sanity checks
        assert_eq!(metainfo.name, "ubuntu-24.04.3-live-server-amd64.iso");
        assert_eq!(metainfo.piece_length, 262144);
        assert_eq!(metainfo.files.len(), 1, "should be single-file torrent");
    }

    // ========================================
    // Multi-File Torrent Parsing Tests
    // ========================================

    /// Helper to create a minimal valid multi-file torrent in bencode format.
    ///
    /// The structure is:
    /// ```text
    /// d
    ///   8:announce <url>
    ///   4:info d
    ///     5:files l
    ///       d 6:length <bytes> 4:path l <components> e e
    ///       ...
    ///     e
    ///     4:name <directory name>
    ///     12:piece length <bytes per piece>
    ///     6:pieces <20 * N bytes of hashes>
    ///   e
    /// e
    /// ```
    fn make_multi_file_torrent(
        announce: &str,
        name: &str,
        files: &[(i64, &[&str])], // (length, path components)
        piece_length: i64,
        pieces: &[u8],
    ) -> Vec<u8> {
        use crate::bencode::encode;

        // Build files list
        let mut files_list = Vec::new();
        for (length, path_components) in files {
            let mut file_entry = BTreeMap::new();
            file_entry.insert(b"length".to_vec(), BencodeValue::Integer(*length));

            let path_list: Vec<BencodeValue> = path_components
                .iter()
                .map(|s| BencodeValue::Bytes(s.as_bytes().to_vec()))
                .collect();
            file_entry.insert(b"path".to_vec(), BencodeValue::List(path_list));

            files_list.push(BencodeValue::Dict(file_entry));
        }

        let mut info = BTreeMap::new();
        info.insert(b"files".to_vec(), BencodeValue::List(files_list));
        info.insert(b"name".to_vec(), BencodeValue::Bytes(name.as_bytes().to_vec()));
        info.insert(
            b"piece length".to_vec(),
            BencodeValue::Integer(piece_length),
        );
        info.insert(b"pieces".to_vec(), BencodeValue::Bytes(pieces.to_vec()));

        let mut root = BTreeMap::new();
        root.insert(
            b"announce".to_vec(),
            BencodeValue::Bytes(announce.as_bytes().to_vec()),
        );
        root.insert(b"info".to_vec(), BencodeValue::Dict(info));

        encode(&BencodeValue::Dict(root))
    }

