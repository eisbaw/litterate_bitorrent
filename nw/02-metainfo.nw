    #[test]
    fn compute_info_hash_simple_dict() {
        // Test compute_info_hash with a simple dictionary
        // The hash should be SHA1 of the bencoded dictionary
        use crate::bencode::encode;

        let mut dict = BTreeMap::new();
        dict.insert(b"name".to_vec(), BencodeValue::Bytes(b"test".to_vec()));
        dict.insert(b"length".to_vec(), BencodeValue::Integer(100));
        let value = BencodeValue::Dict(dict);

        let hash = compute_info_hash(&value);

        // Hash should be 20 bytes and non-zero
        assert_eq!(hash.len(), 20);
        assert_ne!(hash, [0u8; 20]);

        // Verify by computing manually
        use sha1::{Sha1, Digest};
        let encoded = encode(&value);
        let mut hasher = Sha1::new();
        hasher.update(&encoded);
        let expected: [u8; 20] = hasher.finalize().into();
        assert_eq!(hash, expected);
    }

