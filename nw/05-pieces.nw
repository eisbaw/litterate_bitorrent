\subsection{Piece State Tests}

We test the [[PieceState]] enum and its methods thoroughly. These tests verify
the state machine transitions and helper methods work correctly.

<<piece state tests>>=
#[test]
fn piece_state_missing_is_initial_state() {
    let state = PieceState::Missing;
    assert!(state.is_missing());
    assert!(!state.is_in_progress());
    assert!(!state.is_verified());
    assert!(!state.is_failed());
    assert!(state.needs_download());
}

#[test]
fn piece_state_new_in_progress_creates_empty_bitvec() {
    let state = PieceState::new_in_progress(16);
    assert!(state.is_in_progress());
    assert_eq!(state.total_blocks(), Some(16));
    assert_eq!(state.blocks_received_count(), 0);
    assert!(!state.all_blocks_received());
}

#[test]
fn piece_state_verified_state_checks() {
    let state = PieceState::Verified;
    assert!(state.is_verified());
    assert!(!state.is_missing());
    assert!(!state.is_in_progress());
    assert!(!state.is_failed());
    assert!(!state.needs_download());
}

#[test]
fn piece_state_failed_state_checks() {
    let state = PieceState::Failed;
    assert!(state.is_failed());
    assert!(!state.is_missing());
    assert!(!state.is_in_progress());
    assert!(!state.is_verified());
    assert!(state.needs_download()); // Failed pieces need re-download
}

#[test]
fn piece_state_mark_block_received_sets_bit() {
    let mut state = PieceState::new_in_progress(8);

    // First marking should return true (new block)
    assert!(state.mark_block_received(0));
    assert!(state.has_block(0));
    assert_eq!(state.blocks_received_count(), 1);

    // Second marking of same block should return false (duplicate)
    assert!(!state.mark_block_received(0));
    assert_eq!(state.blocks_received_count(), 1);
}

#[test]
fn piece_state_mark_block_out_of_bounds_returns_false() {
    let mut state = PieceState::new_in_progress(4);
    assert!(!state.mark_block_received(10));
    assert_eq!(state.blocks_received_count(), 0);
}

#[test]
fn piece_state_mark_block_on_non_in_progress_returns_false() {
    let mut missing = PieceState::Missing;
    assert!(!missing.mark_block_received(0));

    let mut verified = PieceState::Verified;
    assert!(!verified.mark_block_received(0));

    let mut failed = PieceState::Failed;
    assert!(!failed.mark_block_received(0));
}

#[test]
fn piece_state_all_blocks_received_when_complete() {
    let mut state = PieceState::new_in_progress(3);

    assert!(!state.all_blocks_received());
    state.mark_block_received(0);
    assert!(!state.all_blocks_received());
    state.mark_block_received(1);
    assert!(!state.all_blocks_received());
    state.mark_block_received(2);
    assert!(state.all_blocks_received());
}

#[test]
fn piece_state_has_block_checks_specific_block() {
    let mut state = PieceState::new_in_progress(4);

    assert!(!state.has_block(1));
    state.mark_block_received(1);
    assert!(state.has_block(1));
    assert!(!state.has_block(0));
    assert!(!state.has_block(2));
}

#[test]
fn piece_state_has_block_on_non_in_progress_returns_false() {
    let missing = PieceState::Missing;
    assert!(!missing.has_block(0));

    let verified = PieceState::Verified;
    assert!(!verified.has_block(0));
}

#[test]
fn piece_state_implements_clone() {
    let state = PieceState::new_in_progress(8);
    let cloned = state.clone();
    assert!(cloned.is_in_progress());
    assert_eq!(cloned.total_blocks(), Some(8));
}

#[test]
fn piece_state_implements_debug() {
    let state = PieceState::new_in_progress(4);
    let debug_str = format!("{:?}", state);
    assert!(debug_str.contains("InProgress"));
    assert!(debug_str.contains("blocks_received"));
}

#[test]
fn piece_state_total_blocks_returns_none_for_non_in_progress() {
    assert_eq!(PieceState::Missing.total_blocks(), None);
    assert_eq!(PieceState::Verified.total_blocks(), None);
    assert_eq!(PieceState::Failed.total_blocks(), None);
}

#[test]
fn piece_state_blocks_received_count_returns_zero_for_non_in_progress() {
    assert_eq!(PieceState::Missing.blocks_received_count(), 0);
    assert_eq!(PieceState::Verified.blocks_received_count(), 0);
    assert_eq!(PieceState::Failed.blocks_received_count(), 0);
}
