#[test]
fn piece_manager_new_creates_all_missing() {
    let hashes = vec![[0u8; 20]; 5];
    let manager = PieceManager::new(100, 500, hashes).unwrap();

    assert_eq!(manager.num_pieces(), 5);
    for i in 0..5 {
        assert!(manager.get_state(i).unwrap().is_missing());
    }
}

#[test]
fn piece_manager_new_validates_hash_count() {
    // 300 bytes with 100-byte pieces = 3 pieces, but we provide 4 hashes
    let hashes = vec![[0u8; 20]; 4];
    let result = PieceManager::new(100, 300, hashes);
    assert!(result.is_err());
}

#[test]
fn piece_manager_new_handles_partial_last_piece() {
    // 250 bytes with 100-byte pieces = 3 pieces (100 + 100 + 50)
    let hashes = vec![[0u8; 20]; 3];
    let manager = PieceManager::new(100, 250, hashes).unwrap();

    assert_eq!(manager.num_pieces(), 3);
    assert_eq!(manager.get_piece_size(0).unwrap(), 100);
    assert_eq!(manager.get_piece_size(1).unwrap(), 100);
    assert_eq!(manager.get_piece_size(2).unwrap(), 50);
}

#[test]
fn piece_manager_get_state_validates_index() {
    let hashes = vec![[0u8; 20]; 3];
    let manager = PieceManager::new(100, 300, hashes).unwrap();

    assert!(manager.get_state(0).is_ok());
    assert!(manager.get_state(2).is_ok());
    assert!(manager.get_state(3).is_err());
    assert!(manager.get_state(100).is_err());
}

#[test]
fn piece_manager_start_piece_transitions_to_in_progress() {
    let hashes = vec![[0u8; 20]; 3];
    let mut manager = PieceManager::new(100, 300, hashes).unwrap();

    assert!(manager.get_state(1).unwrap().is_missing());
    manager.start_piece(1).unwrap();
    assert!(manager.get_state(1).unwrap().is_in_progress());

    // Verify correct number of blocks
    // 100 bytes / 16384 = 1 block (ceiling division)
    assert_eq!(manager.get_state(1).unwrap().total_blocks(), Some(1));
}

#[test]
fn piece_manager_start_piece_from_failed() {
    let hashes = vec![[0u8; 20]; 3];
    let mut manager = PieceManager::new(100, 300, hashes).unwrap();

    // Simulate failed piece
    manager.start_piece(0).unwrap();
    manager.mark_failed(0).unwrap();
    assert!(manager.get_state(0).unwrap().is_failed());

    // Should be able to restart
    manager.start_piece(0).unwrap();
    assert!(manager.get_state(0).unwrap().is_in_progress());
}

#[test]
fn piece_manager_start_piece_noop_on_verified() {
    let hashes = vec![[0u8; 20]; 3];
    let mut manager = PieceManager::new(100, 300, hashes).unwrap();

    manager.mark_verified(0).unwrap();
    manager.start_piece(0).unwrap(); // Should be no-op
    assert!(manager.get_state(0).unwrap().is_verified());
}

#[test]
fn piece_manager_mark_block_received_tracks_blocks() {
    // Use larger piece to have multiple blocks
    // 40000 bytes = 3 blocks (16384 + 16384 + 7232)
    let hashes = vec![[0u8; 20]; 1];
    let mut manager = PieceManager::new(40000, 40000, hashes).unwrap();

    manager.start_piece(0).unwrap();

    // First block should be new
    assert!(manager.mark_block_received(0, 0).unwrap());
    // Same block should be duplicate
    assert!(!manager.mark_block_received(0, 0).unwrap());

    // Second block should be new
    assert!(manager.mark_block_received(0, 1).unwrap());

    // Not all blocks received yet
    assert!(!manager.all_blocks_received(0).unwrap());

    // Third block completes the piece
    assert!(manager.mark_block_received(0, 2).unwrap());
    assert!(manager.all_blocks_received(0).unwrap());
}

#[test]
fn piece_manager_mark_verified_transitions_state() {
    let hashes = vec![[0u8; 20]; 3];
    let mut manager = PieceManager::new(100, 300, hashes).unwrap();

    manager.start_piece(1).unwrap();
    manager.mark_verified(1).unwrap();

    assert!(manager.get_state(1).unwrap().is_verified());
    assert_eq!(manager.verified_count(), 1);
}

#[test]
fn piece_manager_mark_failed_transitions_state() {
    let hashes = vec![[0u8; 20]; 3];
    let mut manager = PieceManager::new(100, 300, hashes).unwrap();

    manager.start_piece(2).unwrap();
    manager.mark_failed(2).unwrap();

    assert!(manager.get_state(2).unwrap().is_failed());
    assert!(manager.get_state(2).unwrap().needs_download());
}

#[test]
fn piece_manager_completion_tracking() {
    let hashes = vec![[0u8; 20]; 3];
    let mut manager = PieceManager::new(100, 300, hashes).unwrap();

    assert!(!manager.is_complete());
    assert_eq!(manager.pending_count(), 3);
    assert_eq!(manager.verified_count(), 0);

    manager.mark_verified(0).unwrap();
    assert!(!manager.is_complete());
    assert_eq!(manager.pending_count(), 2);
    assert_eq!(manager.verified_count(), 1);

    manager.mark_verified(1).unwrap();
    manager.mark_verified(2).unwrap();
    assert!(manager.is_complete());
    assert_eq!(manager.pending_count(), 0);
    assert_eq!(manager.verified_count(), 3);
}

#[test]
fn piece_manager_get_hash_returns_correct_hash() {
    let hash0 = [0u8; 20];
    let hash1 = [1u8; 20];
    let hash2 = [2u8; 20];
    let hashes = vec![hash0, hash1, hash2];
    let manager = PieceManager::new(100, 300, hashes).unwrap();

    assert_eq!(*manager.get_hash(0).unwrap(), hash0);
    assert_eq!(*manager.get_hash(1).unwrap(), hash1);
    assert_eq!(*manager.get_hash(2).unwrap(), hash2);
    assert!(manager.get_hash(3).is_err());
}

#[test]
fn piece_manager_empty_torrent() {
    let hashes: Vec<[u8; 20]> = vec![];
    let manager = PieceManager::new(100, 0, hashes).unwrap();

    assert_eq!(manager.num_pieces(), 0);
    assert!(manager.is_complete()); // No pieces means complete
    assert_eq!(manager.verified_count(), 0);
    assert_eq!(manager.pending_count(), 0);
}

#[test]
fn piece_manager_implements_debug() {
    let hashes = vec![[0u8; 20]; 2];
    let manager = PieceManager::new(100, 200, hashes).unwrap();
    let debug_str = format!("{:?}", manager);
    assert!(debug_str.contains("PieceManager"));
}
