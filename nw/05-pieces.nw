\subsection{Error Display Tests}

We verify that each error variant produces a human-readable message containing
the relevant information. These tests document the expected error message format.

<<piece error display tests>>=
#[test]
fn hash_mismatch_displays_all_context() {
    let err = PieceError::PieceHashMismatch {
        piece_index: 42,
        expected_hash: "a94a8fe5ccb19ba61c4c0873d391e987982fbbd3".to_string(),
        computed_hash: "0000000000000000000000000000000000000000".to_string(),
    };
    let msg = err.to_string();
    assert!(msg.contains("42"), "should contain piece index: {}", msg);
    assert!(msg.contains("a94a8fe5ccb19ba61c4c0873d391e987982fbbd3"),
            "should contain expected hash: {}", msg);
    assert!(msg.contains("0000000000000000000000000000000000000000"),
            "should contain computed hash: {}", msg);
    assert!(msg.contains("mismatch"), "should mention mismatch: {}", msg);
}

#[test]
fn invalid_index_displays_index_and_range() {
    let err = PieceError::InvalidPieceIndex {
        index: 999,
        num_pieces: 100,
    };
    let msg = err.to_string();
    assert!(msg.contains("999"), "should contain invalid index: {}", msg);
    assert!(msg.contains("100"), "should contain num_pieces: {}", msg);
    assert!(msg.contains("invalid"), "should mention invalid: {}", msg);
}

#[test]
fn invalid_offset_displays_full_context() {
    let err = PieceError::InvalidBlockOffset {
        piece_index: 5,
        offset: 262144,
        piece_size: 262144,
    };
    let msg = err.to_string();
    assert!(msg.contains("5"), "should contain piece index: {}", msg);
    assert!(msg.contains("262144"), "should contain offset and size: {}", msg);
    assert!(msg.contains("offset"), "should mention offset: {}", msg);
}

#[test]
fn disk_write_error_displays_path_and_offset() {
    let io_err = io::Error::new(io::ErrorKind::Other, "disk full");
    let err = PieceError::DiskWriteError {
        path: PathBuf::from("/data/download.iso"),
        byte_offset: 1048576,
        source: io_err,
    };
    let msg = err.to_string();
    assert!(msg.contains("/data/download.iso"), "should contain path: {}", msg);
    assert!(msg.contains("1048576"), "should contain byte offset: {}", msg);
    assert!(msg.contains("disk full"), "should contain underlying error: {}", msg);
}
