#[test]
fn in_progress_piece_receive_all_blocks_any_order_completes() {
    // This test specifically verifies AC #6:
    // "receive all blocks out of order, verify is_complete returns true"

    // 65536 bytes = 4 blocks of BLOCK_SIZE each
    let piece_size = BLOCK_SIZE * 4;
    let mut piece = InProgressPiece::new(7, piece_size);

    // Receive in scrambled order: 2, 0, 3, 1
    let orders = [2, 0, 3, 1];
    for (i, &block_idx) in orders.iter().enumerate() {
        let offset = block_idx * BLOCK_SIZE;
        let data = vec![block_idx as u8; BLOCK_SIZE as usize];

        let was_new = piece.receive_block(offset, &data).unwrap();
        assert!(was_new, "block {} should be new", block_idx);

        if i < 3 {
            assert!(!piece.is_complete(), "should not be complete after {} blocks", i + 1);
        }
    }

    assert!(piece.is_complete(), "should be complete after all 4 blocks");
    assert_eq!(piece.blocks_received_count(), 4);

    // Verify data integrity - each block should contain its index as all bytes
    let data = piece.data();
    for block_idx in 0..4u32 {
        let start = (block_idx * BLOCK_SIZE) as usize;
        assert_eq!(data[start], block_idx as u8,
            "block {} should start with {}", block_idx, block_idx);
    }
}
