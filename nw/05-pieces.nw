use std::collections::HashMap as TestHashMap;

#[test]
fn scheduler_new_creates_empty_scheduler() {
    let scheduler = RequestScheduler::new(SchedulerConfig::default());
    assert_eq!(scheduler.pending_count(), 0);
}

#[test]
fn scheduler_config_default_values() {
    let config = SchedulerConfig::default();
    assert_eq!(config.pipeline_limit, 10);
    assert_eq!(config.request_timeout, Duration::from_secs(30));
}

#[test]
fn scheduler_config_builder_pattern() {
    let config = SchedulerConfig::default()
        .with_pipeline_limit(16)
        .with_timeout(Duration::from_secs(60));

    assert_eq!(config.pipeline_limit, 16);
    assert_eq!(config.request_timeout, Duration::from_secs(60));
}

#[test]
fn scheduler_register_request_tracks_correctly() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    let request = BlockRequest::new(0, 0, BLOCK_SIZE, peer_id);
    assert!(scheduler.register_request(request));

    assert_eq!(scheduler.pending_count(), 1);
    assert_eq!(scheduler.peer_request_count(&peer_id), 1);
    assert!(scheduler.is_block_pending(0, 0));
}

#[test]
fn scheduler_register_request_rejects_duplicate() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    let request1 = BlockRequest::new(0, 0, BLOCK_SIZE, peer_id);
    let request2 = BlockRequest::new(0, 0, BLOCK_SIZE, peer_id);

    assert!(scheduler.register_request(request1));
    assert!(!scheduler.register_request(request2)); // Duplicate

    assert_eq!(scheduler.pending_count(), 1);
}

#[test]
fn scheduler_available_slots_respects_pipeline_limit() {
    let config = SchedulerConfig::default().with_pipeline_limit(3);
    let mut scheduler = RequestScheduler::new(config);
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    assert_eq!(scheduler.available_slots(&peer_id), 3);

    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_id));
    assert_eq!(scheduler.available_slots(&peer_id), 2);

    scheduler.register_request(BlockRequest::new(0, BLOCK_SIZE, BLOCK_SIZE, peer_id));
    assert_eq!(scheduler.available_slots(&peer_id), 1);

    scheduler.register_request(BlockRequest::new(0, 2 * BLOCK_SIZE, BLOCK_SIZE, peer_id));
    assert_eq!(scheduler.available_slots(&peer_id), 0);
}

#[test]
fn scheduler_complete_request_decrements_count() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_id));
    scheduler.register_request(BlockRequest::new(0, BLOCK_SIZE, BLOCK_SIZE, peer_id));

    assert_eq!(scheduler.peer_request_count(&peer_id), 2);

    let completed = scheduler.complete_request(0, 0);
    assert!(completed.is_some());
    assert_eq!(completed.unwrap().state, RequestState::Completed);

    assert_eq!(scheduler.pending_count(), 1);
    assert_eq!(scheduler.peer_request_count(&peer_id), 1);
    assert!(!scheduler.is_block_pending(0, 0));
    assert!(scheduler.is_block_pending(0, BLOCK_SIZE));
}

#[test]
fn scheduler_cancel_request_removes_and_returns() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_id));

    let cancelled = scheduler.cancel_request(0, 0);
    assert!(cancelled.is_some());
    assert_eq!(cancelled.unwrap().state, RequestState::Cancelled);

    assert_eq!(scheduler.pending_count(), 0);
    assert_eq!(scheduler.peer_request_count(&peer_id), 0);
}

#[test]
fn scheduler_cancel_peer_requests_removes_all() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_a: PeerId = *b"-RS0001-aaaaaaaaaaaa";
    let peer_b: PeerId = *b"-RS0001-bbbbbbbbbbbb";

    // Register requests for both peers
    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_a));
    scheduler.register_request(BlockRequest::new(0, BLOCK_SIZE, BLOCK_SIZE, peer_a));
    scheduler.register_request(BlockRequest::new(1, 0, BLOCK_SIZE, peer_b));

    assert_eq!(scheduler.pending_count(), 3);

    // Cancel peer A's requests
    let cancelled = scheduler.cancel_peer_requests(&peer_a);

    assert_eq!(cancelled.len(), 2);
    assert!(cancelled.iter().all(|p| p.state == RequestState::Cancelled));
    assert!(cancelled.iter().all(|p| p.request.peer == peer_a));

    // Peer B's request should still be pending
    assert_eq!(scheduler.pending_count(), 1);
    assert_eq!(scheduler.peer_request_count(&peer_a), 0);
    assert_eq!(scheduler.peer_request_count(&peer_b), 1);
}

#[test]
fn scheduler_in_flight_offsets_for_piece() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_id));
    scheduler.register_request(BlockRequest::new(0, BLOCK_SIZE, BLOCK_SIZE, peer_id));
    scheduler.register_request(BlockRequest::new(1, 0, BLOCK_SIZE, peer_id)); // Different piece

    let offsets = scheduler.in_flight_offsets_for_piece(0);

    assert_eq!(offsets.len(), 2);
    assert!(offsets.contains(&0));
    assert!(offsets.contains(&BLOCK_SIZE));
}

#[test]
fn scheduler_integrates_with_block_selection() {
    let scheduler = RequestScheduler::new(SchedulerConfig::default());

    // Setup: 1 piece with 4 blocks in InProgress state
    let hashes = vec![[0u8; 20]; 1];
    let mut manager = PieceManager::new(BLOCK_SIZE * 4, (BLOCK_SIZE * 4) as u64, hashes).unwrap();
    manager.start_piece(0).unwrap(); // Must be InProgress for select_next_blocks

    // Use select_next_blocks with scheduler's in_flight tracking
    let in_flight = scheduler.in_flight_offsets_for_piece(0);
    let blocks = select_next_blocks(&manager, 0, &in_flight, 2);

    // Should get 2 blocks (limited by max_blocks parameter)
    assert_eq!(blocks.len(), 2);
    assert_eq!(blocks[0].0, 0); // First block at offset 0
    assert_eq!(blocks[1].0, BLOCK_SIZE); // Second block at offset BLOCK_SIZE
}

#[test]
fn scheduler_request_blocks_avoids_pending() {
    let mut scheduler = RequestScheduler::new(SchedulerConfig::default());
    let peer_a: PeerId = *b"-RS0001-aaaaaaaaaaaa";

    // Setup: 1 piece with 4 blocks in InProgress state
    let hashes = vec![[0u8; 20]; 1];
    let mut manager = PieceManager::new(BLOCK_SIZE * 4, (BLOCK_SIZE * 4) as u64, hashes).unwrap();
    manager.start_piece(0).unwrap(); // Must be InProgress for select_next_blocks

    // Peer A already requested block 0
    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_a));

    // Get blocks excluding in-flight ones
    let in_flight = scheduler.in_flight_offsets_for_piece(0);
    let blocks = select_next_blocks(&manager, 0, &in_flight, 10);

    // Should not include offset 0 (already pending)
    for (offset, _) in &blocks {
        assert!(*offset != 0, "should not request pending block at offset 0");
    }
    // Should still get the other 3 blocks
    assert_eq!(blocks.len(), 3);
}

#[test]
fn scheduler_rarest_first_selection() {
    // Test rarest-first selection using select_rarest directly
    // (The scheduler integrates with select_rarest for piece prioritization)

    // Setup: 2 pieces (both Missing - eligible for rarest-first selection)
    let hashes = vec![[0u8; 20]; 2];
    let manager = PieceManager::new(BLOCK_SIZE, (BLOCK_SIZE * 2) as u64, hashes).unwrap();

    let mut availability = PieceAvailability::new(2);
    // Piece 0: availability 3, Piece 1: availability 1 (rarer)
    availability.add_peer_bitfield(&[0b11000000]);
    availability.add_peer_bitfield(&[0b10000000]);
    availability.add_peer_bitfield(&[0b10000000]);

    // Peer has both pieces
    let peer_bitfield = vec![0b11000000];

    let selection = select_rarest(&manager, &availability, &peer_bitfield);

    // First piece should be piece 1 (rarer)
    assert!(!selection.is_empty());
    assert_eq!(selection[0], 1, "rarest piece should be first");
}

