#[test]
fn tiebreaker_distributes_across_equal_pieces_over_many_runs() {
    // Four pieces all with availability 1
    let candidates = vec![(10u32, 1u32), (20, 1), (30, 1), (40, 1)];

    // Count selections over many iterations with different seeds
    let mut counts = std::collections::HashMap::new();
    for seed in 0..1000 {
        let mut rng = StdRng::seed_from_u64(seed);
        let selected = select_piece_with_tiebreaker(&candidates, &mut rng).unwrap();
        *counts.entry(selected).or_insert(0) += 1;
    }

    // All four pieces should be selected at least once
    assert_eq!(counts.len(), 4, "Expected all 4 pieces to be selected at least once");

    // Each piece should be selected roughly 25% of the time (250 +/- margin)
    // With 1000 trials and 4 choices, expected ~250 each
    // Using a lenient margin to avoid flaky tests
    for (piece, count) in &counts {
        assert!(*count > 100 && *count < 400,
                "Piece {} selected {} times, expected roughly 250", piece, count);
    }
}

