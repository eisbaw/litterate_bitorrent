fn tiebreaker_selects_minimum_availability_piece() {
    let mut rng = StdRng::seed_from_u64(12345);

    // Piece 10 has availability 2 (minimum), others have higher
    let candidates = vec![
        (5u32, 5u32),   // availability 5
        (10, 2),        // availability 2 (minimum)
        (15, 4),        // availability 4
        (20, 3),        // availability 3
    ];

    // Should always select piece 10 since it's the only one with min availability
    let selected = select_piece_with_tiebreaker(&candidates, &mut rng);
