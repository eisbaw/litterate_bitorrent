\subsubsection{Timeout Behavior Test}

Testing timeout behavior requires care because [[Instant::now()]] cannot be mocked
without additional infrastructure. We test the timeout logic using zero-duration
timeouts, which trigger immediately.

<<request scheduler timeout tests>>=
#[test]
fn scheduler_collect_timed_out_with_zero_timeout() {
    // With zero timeout, all requests immediately time out
    let config = SchedulerConfig::default().with_timeout(Duration::ZERO);
    let mut scheduler = RequestScheduler::new(config);
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_id));
    scheduler.register_request(BlockRequest::new(0, BLOCK_SIZE, BLOCK_SIZE, peer_id));

    let timed_out = scheduler.collect_timed_out();

    assert_eq!(timed_out.len(), 2);
    assert!(timed_out.iter().all(|p| p.state == RequestState::TimedOut));
    assert_eq!(scheduler.pending_count(), 0);
    assert_eq!(scheduler.peer_request_count(&peer_id), 0);
}

#[test]
fn scheduler_collect_timed_out_preserves_fresh_requests() {
    // With 30 second timeout, fresh requests should not time out
    let config = SchedulerConfig::default().with_timeout(Duration::from_secs(30));
    let mut scheduler = RequestScheduler::new(config);
    let peer_id: PeerId = *b"-RS0001-abcdefghijkl";

    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_id));

    let timed_out = scheduler.collect_timed_out();

    assert!(timed_out.is_empty(), "fresh requests should not time out");
    assert_eq!(scheduler.pending_count(), 1);
}

#[test]
fn scheduler_timed_out_can_be_reassigned() {
    // Verify workflow: request times out, gets reassigned to new peer
    let config = SchedulerConfig::default().with_timeout(Duration::ZERO);
    let mut scheduler = RequestScheduler::new(config);

    let peer_a: PeerId = *b"-RS0001-aaaaaaaaaaaa";
    let peer_b: PeerId = *b"-RS0001-bbbbbbbbbbbb";

    // Peer A requests block
    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_a));

    // Request times out
    let timed_out = scheduler.collect_timed_out();
    assert_eq!(timed_out.len(), 1);
    assert_eq!(timed_out[0].request.peer, peer_a);

    // Block is no longer pending
    assert!(!scheduler.is_block_pending(0, 0));

    // Can now reassign to peer B
    scheduler.register_request(BlockRequest::new(0, 0, BLOCK_SIZE, peer_b));

    assert_eq!(scheduler.pending_count(), 1);
    assert_eq!(scheduler.peer_request_count(&peer_b), 1);
    assert!(scheduler.is_block_pending(0, 0));
}
