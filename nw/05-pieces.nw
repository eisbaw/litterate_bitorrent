\subsection{Error Trait Tests}

We verify that [[PieceError]] implements the required traits correctly.

<<piece error trait tests>>=
#[test]
fn piece_error_implements_std_error() {
    fn assert_error<E: std::error::Error>() {}
    assert_error::<PieceError>();
}

#[test]
fn piece_error_implements_debug() {
    let err = PieceError::InvalidPieceIndex {
        index: 10,
        num_pieces: 5,
    };
    // Debug formatting should not panic
    let debug_str = format!("{:?}", err);
    assert!(!debug_str.is_empty());
}

#[test]
fn piece_error_implements_display() {
    let err = PieceError::InvalidPieceIndex {
        index: 10,
        num_pieces: 5,
    };
    // Display formatting should not panic
    let display_str = format!("{}", err);
    assert!(!display_str.is_empty());
}

#[test]
fn disk_write_error_has_source() {
    use std::error::Error;

    let io_err = io::Error::new(io::ErrorKind::PermissionDenied, "access denied");
    let err = PieceError::DiskWriteError {
        path: PathBuf::from("/root/file"),
        byte_offset: 0,
        source: io_err,
    };

    // The error should have a source
    assert!(err.source().is_some(), "DiskWriteError should have a source");
}
