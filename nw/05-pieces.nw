fn tiebreaker_result_is_from_minimum_set() {
    // Pieces 2, 7, 15 have availability 2 (minimum)
    // Pieces 1, 5 have availability 5
    let candidates = vec![
        (1u32, 5u32),
        (2, 2),
        (5, 5),
        (7, 2),
        (15, 2),
    ];

    // Run multiple times to check we always get a piece from the minimum set
    for seed in 0..100 {
        let mut rng = StdRng::seed_from_u64(seed);
        let selected = select_piece_with_tiebreaker(&candidates, &mut rng).unwrap();
        assert!([2, 7, 15].contains(&selected),
                "Selected {} which is not in minimum availability set", selected);
    }
