    availability.add_peer_bitfield(&[0b11111111]); // all +1
    availability.add_peer_bitfield(&[0b10110110]); // 0,2,3,5,6 +1
    availability.add_peer_bitfield(&[0b10010100]); // 0,3,5 +1
    availability.add_peer_bitfield(&[0b00010001]); // 3,7 +1

    // Mark some pieces as complete
    manager.mark_verified(0).unwrap(); // verified, count=3
    manager.mark_verified(3).unwrap(); // verified, count=4

    // Start downloading one piece
    manager.start_piece(5).unwrap(); // in progress, count=3

    // Peer has pieces 1, 2, 3, 5, 6 (0b01110110 = bits 6,5,4,2,1)
    // Note: peer does NOT have piece 4 (bit 3 is 0)
    let peer_bitfield = vec![0b01110110];

    let selection = select_rarest(&manager, &availability, &peer_bitfield);

    // Expected:
    // - Piece 0: EXCLUDED (verified)
    // - Piece 1: count=1, peer has it -> INCLUDE
    // - Piece 2: count=2, peer has it -> INCLUDE
    // - Piece 3: EXCLUDED (verified)
    // - Piece 4: count=1, peer does NOT have it -> EXCLUDE
    // - Piece 5: EXCLUDED (in progress)
    // - Piece 6: count=2, peer has it -> INCLUDE
    // - Piece 7: count=2, peer does NOT have it -> EXCLUDE
    // Sorted by availability: [1, 2, 6] (counts: 1, 2, 2)
    // Tie between 2 and 6 broken by index
    assert_eq!(selection, vec![1, 2, 6]);
}

