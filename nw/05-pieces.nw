\subsection{Helper Method Tests}

We test the helper constructors to ensure they produce correctly-formatted errors.

<<piece error helper tests>>=
#[test]
fn hash_mismatch_helper_formats_hashes_as_hex() {
    let expected: [u8; 20] = [
        0xa9, 0x4a, 0x8f, 0xe5, 0xcc, 0xb1, 0x9b, 0xa6, 0x1c, 0x4c,
        0x08, 0x73, 0xd3, 0x91, 0xe9, 0x87, 0x98, 0x2f, 0xbb, 0xd3,
    ];
    let computed: [u8; 20] = [0u8; 20];

    let err = PieceError::hash_mismatch(7, &expected, &computed);
    let msg = err.to_string();

    assert!(msg.contains("a94a8fe5ccb19ba61c4c0873d391e987982fbbd3"),
            "should contain hex-encoded expected hash: {}", msg);
    assert!(msg.contains("0000000000000000000000000000000000000000"),
            "should contain hex-encoded computed hash: {}", msg);
    assert!(msg.contains("7"), "should contain piece index: {}", msg);
}

#[test]
fn invalid_index_helper_constructs_correctly() {
    let err = PieceError::invalid_index(50, 25);
    match err {
        PieceError::InvalidPieceIndex { index, num_pieces } => {
            assert_eq!(index, 50);
            assert_eq!(num_pieces, 25);
        }
        _ => panic!("wrong variant"),
    }
}

#[test]
fn invalid_offset_helper_constructs_correctly() {
    let err = PieceError::invalid_offset(3, 16384, 16000);
    match err {
        PieceError::InvalidBlockOffset { piece_index, offset, piece_size } => {
            assert_eq!(piece_index, 3);
            assert_eq!(offset, 16384);
            assert_eq!(piece_size, 16000);
        }
        _ => panic!("wrong variant"),
    }
}

#[test]
fn disk_write_helper_accepts_string_path() {
    let err = PieceError::disk_write(
        "/tmp/test.dat",
        512,
        io::Error::new(io::ErrorKind::NotFound, "not found"),
    );
    match err {
        PieceError::DiskWriteError { path, byte_offset, .. } => {
            assert_eq!(path, PathBuf::from("/tmp/test.dat"));
            assert_eq!(byte_offset, 512);
        }
        _ => panic!("wrong variant"),
    }
}

#[test]
fn disk_write_helper_accepts_pathbuf() {
    let err = PieceError::disk_write(
        PathBuf::from("/var/data/file.bin"),
        1024,
        io::Error::new(io::ErrorKind::Other, "other"),
    );
    match err {
        PieceError::DiskWriteError { path, byte_offset, .. } => {
            assert_eq!(path, PathBuf::from("/var/data/file.bin"));
            assert_eq!(byte_offset, 1024);
        }
        _ => panic!("wrong variant"),
    }
}
