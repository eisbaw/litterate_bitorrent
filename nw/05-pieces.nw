#[test]
fn in_progress_piece_new_initializes_correctly() {
    let piece = InProgressPiece::new(5, 40000);

    assert_eq!(piece.piece_index(), 5);
    assert_eq!(piece.piece_size(), 40000);
    // 40000 bytes = 3 blocks (16384 + 16384 + 7232)
    assert_eq!(piece.num_blocks(), 3);
    assert_eq!(piece.blocks_received_count(), 0);
    assert!(!piece.is_complete());
}

#[test]
fn in_progress_piece_receive_block_stores_data() {
    let mut piece = InProgressPiece::new(0, BLOCK_SIZE);
    let block_data: Vec<u8> = (0..BLOCK_SIZE).map(|i| (i % 256) as u8).collect();

    assert!(piece.receive_block(0, &block_data).unwrap());
    assert!(piece.is_complete());

    let data = piece.data();
    for i in 0..BLOCK_SIZE as usize {
        assert_eq!(data[i], (i % 256) as u8);
    }
}

#[test]
fn in_progress_piece_receive_blocks_out_of_order() {
    // 40000 bytes = 3 blocks
    let mut piece = InProgressPiece::new(0, 40000);

    // Create distinct data for each block
    let block0: Vec<u8> = vec![0u8; BLOCK_SIZE as usize];
    let block1: Vec<u8> = vec![1u8; BLOCK_SIZE as usize];
    let block2: Vec<u8> = vec![2u8; 7232]; // Last block is smaller

    // Receive in reverse order: 2, 0, 1
    assert!(piece.receive_block(2 * BLOCK_SIZE, &block2).unwrap());
    assert!(!piece.is_complete());
    assert_eq!(piece.blocks_received_count(), 1);

    assert!(piece.receive_block(0, &block0).unwrap());
    assert!(!piece.is_complete());
    assert_eq!(piece.blocks_received_count(), 2);

    assert!(piece.receive_block(BLOCK_SIZE, &block1).unwrap());
    assert!(piece.is_complete());
    assert_eq!(piece.blocks_received_count(), 3);

    // Verify data is correctly positioned
    let data = piece.data();
    assert_eq!(data[0], 0);                           // Start of block 0
    assert_eq!(data[BLOCK_SIZE as usize], 1);         // Start of block 1
    assert_eq!(data[2 * BLOCK_SIZE as usize], 2);     // Start of block 2
}

