#[test]
fn tiebreaker_with_fixed_seed_is_deterministic() {
    // Three pieces all with availability 1
    let candidates = vec![(5u32, 1u32), (12, 1), (27, 1)];

    // Run multiple times with the same seed
    let mut results = Vec::new();
    for _ in 0..5 {
        let mut rng = StdRng::seed_from_u64(42);
        results.push(select_piece_with_tiebreaker(&candidates, &mut rng));
    }

    // All results should be identical (deterministic)
    assert!(results.windows(2).all(|w| w[0] == w[1]),
            "Expected deterministic results with same seed, got {:?}", results);
