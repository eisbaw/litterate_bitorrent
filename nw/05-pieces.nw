    let hashes = vec![[0u8; 20]; 1];
    let mut manager = PieceManager::new(65536, 65536, hashes).unwrap();

    manager.start_piece(0).unwrap();

    // Block 1 is in-flight
    let mut in_flight = HashSet::new();
    in_flight.insert(BLOCK_SIZE); // offset of block 1

    let blocks = select_next_blocks(&manager, 0, &in_flight, 10);

