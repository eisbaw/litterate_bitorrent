fn tiebreaker_returns_single_piece_when_one_candidate() {
    let mut rng = StdRng::seed_from_u64(42);
    let candidates = vec![(7u32, 3u32)];

    assert_eq!(select_piece_with_tiebreaker(&candidates, &mut rng), Some(7));
