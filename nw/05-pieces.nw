    assert!(piece.receive_block(0, &block_data).unwrap()); // returns true (new)

    // Duplicate receive
    let different_data = vec![99u8; BLOCK_SIZE as usize];
    assert!(!piece.receive_block(0, &different_data).unwrap()); // returns false (dup)

    // Original data should be preserved
    assert_eq!(piece.data()[0], 42);
    assert_eq!(piece.blocks_received_count(), 1);
}

