\subsection{Testing Validation}

Validation tests require creating temporary files and directories. We use
[[tempfile]] for this purpose, which ensures cleanup even if tests panic.
These tests verify each validation check produces the correct error type
and includes the problematic value in the message.

<<cli validation tests>>=
#[cfg(test)]
mod validation_tests {
    use super::*;
    use std::fs::File;
    use tempfile::tempdir;

    // Helper to create Args with specific values
    fn make_args(torrent: &str, output: &str, port: u16) -> Args {
        Args {
            torrent: PathBuf::from(torrent),
            output: PathBuf::from(output),
            port,
            verbose: false,
        }
    }

    // ========================================================================
    // Torrent file validation tests
    // ========================================================================

    #[test]
    fn torrent_file_not_found_produces_error() {
        // AC #1: Torrent file path is checked for existence before parsing
        // AC #2: Torrent file path produces error with path in message
        let args = make_args("/nonexistent/path/to/missing.torrent", "/tmp", 6881);
        let result = validate_args(&args);

        assert!(result.is_err());
        let err = result.unwrap_err();
        let msg = err.to_string();

        // Error should include the exact path
        assert!(
            msg.contains("/nonexistent/path/to/missing.torrent"),
            "Error should include the torrent path: {}",
            msg
        );
        assert!(
            msg.contains("not found") || msg.contains("Not found"),
            "Error should indicate file not found: {}",
            msg
        );
    }

    #[test]
    fn torrent_path_is_directory_produces_error() {
        // If user passes a directory instead of a file, give clear error
        let dir = tempdir().unwrap();
        let args = make_args(dir.path().to_str().unwrap(), "/tmp", 6881);

        let result = validate_args(&args);
        assert!(result.is_err());
        let err = result.unwrap_err();
        let msg = err.to_string();

        assert!(
            msg.contains("directory") || msg.contains("not a file"),
            "Error should indicate path is a directory: {}",
            msg
        );
    }

    #[test]
    fn valid_torrent_file_passes_validation() {
        // Create a temporary torrent file
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            6881
        );

        let result = validate_args(&args);
        assert!(result.is_ok(), "Valid torrent file should pass: {:?}", result);
    }

    // ========================================================================
    // Output directory validation tests
    // ========================================================================

    #[test]
    fn output_directory_is_created_if_missing() {
        // AC #3: Output directory is created if it does not exist
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        // Create a path that doesn't exist yet
        let new_output = dir.path().join("new_output_dir");
        assert!(!new_output.exists());

        let args = make_args(
            torrent_path.to_str().unwrap(),
            new_output.to_str().unwrap(),
            6881
        );

        let result = validate_args(&args);
        assert!(result.is_ok(), "Should create output directory: {:?}", result);
        assert!(new_output.exists(), "Output directory should now exist");
        assert!(new_output.is_dir(), "Output should be a directory");
    }

    #[test]
    fn nested_output_directory_is_created() {
        // AC #3: Output directory is created with parent directories
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        // Create a nested path
        let nested_output = dir.path().join("a/b/c/deep/path");
        assert!(!nested_output.exists());

        let args = make_args(
            torrent_path.to_str().unwrap(),
            nested_output.to_str().unwrap(),
            6881
        );

        let result = validate_args(&args);
        assert!(result.is_ok(), "Should create nested output directory: {:?}", result);
        assert!(nested_output.exists(), "Nested output directory should exist");
    }

    #[test]
    fn output_path_is_file_produces_error() {
        // If output path exists as a file, give clear error
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        // Create a file where we want a directory
        let file_path = dir.path().join("not_a_dir");
        File::create(&file_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            file_path.to_str().unwrap(),
            6881
        );

        let result = validate_args(&args);
        assert!(result.is_err());
        let msg = result.unwrap_err().to_string();

        assert!(
            msg.contains("not a directory") || msg.contains("exists but"),
            "Error should indicate path is not a directory: {}",
            msg
        );
    }

    #[test]
    fn existing_writable_directory_passes() {
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            6881
        );

        let result = validate_args(&args);
        assert!(result.is_ok(), "Existing writable directory should pass: {:?}", result);
    }

    // ========================================================================
    // Port validation tests
    // ========================================================================

    #[test]
    fn port_zero_produces_error() {
        // AC #5: Invalid port number produces error message
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            0  // Invalid port
        );

        let result = validate_args(&args);
        assert!(result.is_err());
        let msg = result.unwrap_err().to_string();

        // AC #7: All validation errors include the problematic value
        assert!(
            msg.contains("0") || msg.contains("Invalid port"),
            "Error should mention port 0: {}",
            msg
        );
    }

    #[test]
    fn privileged_port_produces_warning() {
        // AC #6: Port below 1024 produces warning about privileged ports
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            80  // HTTP port - privileged
        );

        let result = validate_args(&args);
        assert!(result.is_ok(), "Privileged port should pass (just warn): {:?}", result);

        let validation = result.unwrap();
        assert_eq!(validation.warnings.len(), 1);

        let warning = &validation.warnings[0];
        assert!(matches!(warning, ValidationWarning::PrivilegedPort { port: 80 }));

        let warning_msg = warning.to_string();
        assert!(
            warning_msg.contains("80") && warning_msg.contains("privileged"),
            "Warning should mention port 80 and privileged: {}",
            warning_msg
        );
    }

    #[test]
    fn normal_port_produces_no_warning() {
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            6881  // Standard BitTorrent port
        );

        let result = validate_args(&args);
        assert!(result.is_ok());

        let validation = result.unwrap();
        assert!(
            validation.warnings.is_empty(),
            "Normal port should produce no warnings"
        );
    }

    #[test]
    fn port_1024_is_not_privileged() {
        // Edge case: port 1024 is the first non-privileged port
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            1024
        );

        let result = validate_args(&args);
        assert!(result.is_ok());
        assert!(result.unwrap().warnings.is_empty());
    }

    #[test]
    fn port_1023_is_privileged() {
        // Edge case: port 1023 is the last privileged port
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            1023
        );

        let result = validate_args(&args);
        assert!(result.is_ok());
        assert_eq!(result.unwrap().warnings.len(), 1);
    }

    #[test]
    fn max_port_is_valid() {
        let dir = tempdir().unwrap();
        let torrent_path = dir.path().join("test.torrent");
        File::create(&torrent_path).unwrap();

        let args = make_args(
            torrent_path.to_str().unwrap(),
            dir.path().to_str().unwrap(),
            65535  // Maximum port
        );

        let result = validate_args(&args);
        assert!(result.is_ok());
        assert!(result.unwrap().warnings.is_empty());
    }

    // ========================================================================
    // Error message quality tests
    // ========================================================================

    #[test]
    fn error_messages_include_problematic_values() {
        // AC #7: All validation errors include the problematic value
        let specific_path = "/very/specific/path/that/does/not/exist.torrent";
        let args = make_args(specific_path, "/tmp", 6881);

        let result = validate_args(&args);
        let msg = result.unwrap_err().to_string();

        assert!(
            msg.contains(specific_path),
            "Error should include the exact problematic path: {}",
            msg
        );
    }

    #[test]
    fn validation_error_is_debug() {
        let err = ValidationError::TorrentNotFound {
            path: PathBuf::from("/test/path"),
        };
        let debug = format!("{:?}", err);
        assert!(debug.contains("TorrentNotFound"));
        assert!(debug.contains("/test/path"));
    }

    #[test]
    fn validation_warning_is_debug_and_clone() {
        let warning = ValidationWarning::PrivilegedPort { port: 80 };
        let debug = format!("{:?}", warning);
        assert!(debug.contains("PrivilegedPort"));
        assert!(debug.contains("80"));

        let cloned = warning.clone();
        assert_eq!(warning, cloned);
    }

    #[test]
    fn validation_result_is_debug() {
        let result = ValidationResult { warnings: vec![] };
        let debug = format!("{:?}", result);
        assert!(debug.contains("ValidationResult"));
    }
}
@

The tests cover each acceptance criterion:

\begin{itemize}
\item \textbf{AC \#1}: Required torrent path parsing
\item \textbf{AC \#2}: Output directory option with default
\item \textbf{AC \#3}: Port option with default
\item \textbf{AC \#4}: Verbose flag
\item \textbf{AC \#5}: Help output generation
\item \textbf{AC \#6}: Error messages for invalid input
\end{itemize}

We also test edge cases like paths with spaces, options in different orders,
and the [[Clone]] and [[Debug]] trait implementations that make the type
convenient to use throughout the application.
