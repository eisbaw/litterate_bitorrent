\subsection{Testing the CLI}

Testing command-line parsing requires care because we want to verify both
successful parsing and proper error handling. We use [[try\_parse\_from]]
to test with synthetic arguments, avoiding the need to manipulate process
arguments.

<<cli tests>>=
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn parse_required_torrent_path() {
        // AC #1: CLI accepts required positional argument for torrent file path
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "ubuntu.torrent",
        ]).unwrap();

        assert_eq!(args.torrent, PathBuf::from("ubuntu.torrent"));
    }

    #[test]
    fn parse_torrent_path_with_spaces() {
        // Paths with spaces should work when properly quoted
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "my downloads/ubuntu 22.04.torrent",
        ]).unwrap();

        assert_eq!(
            args.torrent,
            PathBuf::from("my downloads/ubuntu 22.04.torrent")
        );
    }

    #[test]
    fn parse_absolute_torrent_path() {
        // Absolute paths should work
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "/home/user/torrents/file.torrent",
        ]).unwrap();

        assert_eq!(
            args.torrent,
            PathBuf::from("/home/user/torrents/file.torrent")
        );
    }

    #[test]
    fn parse_output_directory_short() {
        // AC #2: CLI accepts -o/--output option for output directory
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "-o", "/tmp/downloads",
        ]).unwrap();

        assert_eq!(args.output, PathBuf::from("/tmp/downloads"));
    }

    #[test]
    fn parse_output_directory_long() {
        // AC #2: --output long form
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "--output", "/tmp/downloads",
        ]).unwrap();

        assert_eq!(args.output, PathBuf::from("/tmp/downloads"));
    }

    #[test]
    fn output_defaults_to_current_dir() {
        // AC #2: output defaults to current directory
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
        ]).unwrap();

        assert_eq!(args.output, PathBuf::from("."));
    }

    #[test]
    fn parse_port_short() {
        // AC #3: CLI accepts -p/--port option for listen port
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "-p", "6889",
        ]).unwrap();

        assert_eq!(args.port, 6889);
    }

    #[test]
    fn parse_port_long() {
        // AC #3: --port long form
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "--port", "12345",
        ]).unwrap();

        assert_eq!(args.port, 12345);
    }

    #[test]
    fn port_defaults_to_6881() {
        // AC #3: port defaults to 6881
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
        ]).unwrap();

        assert_eq!(args.port, 6881);
    }

    #[test]
    fn parse_verbose_short() {
        // AC #4: CLI accepts -v/--verbose flag for DEBUG logging
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "-v",
        ]).unwrap();

        assert!(args.verbose);
    }

    #[test]
    fn parse_verbose_long() {
        // AC #4: --verbose long form
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "--verbose",
        ]).unwrap();

        assert!(args.verbose);
    }

    #[test]
    fn verbose_defaults_to_false() {
        // AC #4: verbose defaults to false
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
        ]).unwrap();

        assert!(!args.verbose);
    }

    #[test]
    fn parse_all_options_combined() {
        // All options can be used together
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "downloads/ubuntu.torrent",
            "-o", "/media/storage",
            "-p", "6999",
            "-v",
        ]).unwrap();

        assert_eq!(args.torrent, PathBuf::from("downloads/ubuntu.torrent"));
        assert_eq!(args.output, PathBuf::from("/media/storage"));
        assert_eq!(args.port, 6999);
        assert!(args.verbose);
    }

    #[test]
    fn parse_options_in_any_order() {
        // Options can appear before or after the positional argument
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "-v",
            "-o", "/tmp",
            "file.torrent",
            "-p", "7000",
        ]).unwrap();

        assert_eq!(args.torrent, PathBuf::from("file.torrent"));
        assert_eq!(args.output, PathBuf::from("/tmp"));
        assert_eq!(args.port, 7000);
        assert!(args.verbose);
    }

    #[test]
    fn help_output_contains_usage() {
        // AC #5: CLI generates --help output with usage examples
        let err = Args::try_parse_from([
            "literate-bittorrent",
            "--help",
        ]).unwrap_err();

        let help_text = err.to_string();

        // Help should contain program name
        assert!(
            help_text.contains("literate-bittorrent"),
            "Help should contain program name: {}",
            help_text
        );

        // Help should mention the torrent argument
        assert!(
            help_text.contains("TORRENT") || help_text.contains("torrent"),
            "Help should mention torrent argument: {}",
            help_text
        );

        // Help should mention output option
        assert!(
            help_text.contains("output") || help_text.contains("-o"),
            "Help should mention output option: {}",
            help_text
        );

        // Help should mention port option
        assert!(
            help_text.contains("port") || help_text.contains("-p"),
            "Help should mention port option: {}",
            help_text
        );

        // Help should mention verbose option
        assert!(
            help_text.contains("verbose") || help_text.contains("-v"),
            "Help should mention verbose option: {}",
            help_text
        );
    }

    #[test]
    fn missing_torrent_produces_helpful_error() {
        // AC #6: Invalid arguments produce helpful error messages
        let err = Args::try_parse_from([
            "literate-bittorrent",
        ]).unwrap_err();

        let error_text = err.to_string();

        // Error should mention the missing argument
        assert!(
            error_text.contains("TORRENT") ||
            error_text.contains("required") ||
            error_text.contains("torrent"),
            "Error should mention missing TORRENT: {}",
            error_text
        );
    }

    #[test]
    fn invalid_port_produces_helpful_error() {
        // AC #6: Invalid port value produces helpful error
        let err = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "-p", "not-a-number",
        ]).unwrap_err();

        let error_text = err.to_string();

        // Error should indicate the value is invalid
        assert!(
            error_text.contains("invalid") ||
            error_text.contains("Invalid") ||
            error_text.contains("not-a-number"),
            "Error should mention invalid port value: {}",
            error_text
        );
    }

    #[test]
    fn port_overflow_produces_error() {
        // Port number exceeding u16 max should fail
        let err = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "-p", "99999",
        ]).unwrap_err();

        let error_text = err.to_string();
        assert!(
            error_text.contains("invalid") ||
            error_text.contains("Invalid") ||
            error_text.contains("99999"),
            "Error should mention invalid port: {}",
            error_text
        );
    }

    #[test]
    fn unknown_option_produces_error() {
        // Unknown options should produce an error
        let err = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
            "--unknown-option",
        ]).unwrap_err();

        let error_text = err.to_string();
        assert!(
            error_text.contains("unexpected") ||
            error_text.contains("unknown") ||
            error_text.contains("--unknown-option"),
            "Error should mention unknown option: {}",
            error_text
        );
    }

    #[test]
    fn args_is_clone() {
        // Args should be Clone for flexibility
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
        ]).unwrap();

        let cloned = args.clone();
        assert_eq!(args, cloned);
    }

    #[test]
    fn args_is_debug() {
        // Args should be Debug for logging
        let args = Args::try_parse_from([
            "literate-bittorrent",
            "file.torrent",
        ]).unwrap();

        let debug_str = format!("{:?}", args);
        assert!(debug_str.contains("Args"));
        assert!(debug_str.contains("file.torrent"));
    }
}

// Note: Testing init_logging directly is challenging because tracing_subscriber
// can only be initialized once per process. The tests below validate the filter
// construction logic in isolation.
#[cfg(test)]
mod logging_tests {
    use tracing_subscriber::EnvFilter;
    use std::env;

    // Helper to build a filter the same way init_logging does
    fn build_filter_for_verbose(verbose: bool) -> EnvFilter {
        let default_level = if verbose { "debug" } else { "info" };
        EnvFilter::try_from_default_env()
            .unwrap_or_else(|_| EnvFilter::new(default_level))
    }

    #[test]
    fn default_filter_is_info() {
        // Temporarily clear RUST_LOG to test default behavior
        let original = env::var("RUST_LOG").ok();
        env::remove_var("RUST_LOG");

        let filter = build_filter_for_verbose(false);
        // The filter should be created successfully (not crash)
        let filter_str = format!("{}", filter);
        // EnvFilter displays its directives; "info" should be present
        assert!(
            filter_str.contains("info"),
            "Default filter should contain 'info': {}",
            filter_str
        );

        // Restore original RUST_LOG if it existed
        if let Some(val) = original {
            env::set_var("RUST_LOG", val);
        }
    }

    #[test]
    fn verbose_filter_is_debug() {
        // Temporarily clear RUST_LOG to test default behavior
        let original = env::var("RUST_LOG").ok();
        env::remove_var("RUST_LOG");

        let filter = build_filter_for_verbose(true);
        let filter_str = format!("{}", filter);
        assert!(
            filter_str.contains("debug"),
            "Verbose filter should contain 'debug': {}",
            filter_str
        );

        // Restore original RUST_LOG if it existed
        if let Some(val) = original {
            env::set_var("RUST_LOG", val);
        }
    }

    #[test]
    fn invalid_rust_log_does_not_crash() {
        // Set an invalid RUST_LOG value
        let original = env::var("RUST_LOG").ok();
        env::set_var("RUST_LOG", "this-is-not-valid[[[");

        // This should not panic - it should fall back to default
        let filter = build_filter_for_verbose(false);
        let filter_str = format!("{}", filter);
        // Should have fallen back to "info" (the default for non-verbose)
        assert!(
            filter_str.contains("info"),
            "Invalid RUST_LOG should fall back to default: {}",
            filter_str
        );

        // Restore original RUST_LOG
        if let Some(val) = original {
            env::set_var("RUST_LOG", val);
        } else {
            env::remove_var("RUST_LOG");
        }
    }

    #[test]
    fn valid_rust_log_is_respected() {
        // Set a valid RUST_LOG value
        let original = env::var("RUST_LOG").ok();
        env::set_var("RUST_LOG", "warn");

        let filter = build_filter_for_verbose(false);
        let filter_str = format!("{}", filter);
        // Should use the RUST_LOG value, not the default
        assert!(
            filter_str.contains("warn"),
            "Valid RUST_LOG should be respected: {}",
            filter_str
        );

        // Restore original RUST_LOG
        if let Some(val) = original {
            env::set_var("RUST_LOG", val);
        } else {
            env::remove_var("RUST_LOG");
        }
    }

    #[test]
    fn rust_log_overrides_verbose() {
        // RUST_LOG should take precedence over verbose flag
        let original = env::var("RUST_LOG").ok();
        env::set_var("RUST_LOG", "error");

        let filter = build_filter_for_verbose(true); // verbose=true, but RUST_LOG=error
        let filter_str = format!("{}", filter);
        // Should use RUST_LOG value "error", not "debug" from verbose flag
        assert!(
            filter_str.contains("error"),
            "RUST_LOG should override verbose flag: {}",
            filter_str
        );

        // Restore original RUST_LOG
        if let Some(val) = original {
            env::set_var("RUST_LOG", val);
        } else {
            env::remove_var("RUST_LOG");
        }
    }
}
