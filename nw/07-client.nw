    /// Helper to create a mock PeerConnection for testing.
    ///
    /// Since PeerConnection requires a TcpStream, we use a mock server
    /// to create a real connection for testing.
    async fn create_test_peer_connection(num_pieces: usize) -> PeerConnection {
        use tokio::net::TcpListener;
        use crate::messages::Handshake;

        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
        let addr = listener.local_addr().unwrap();

        let connect_handle = tokio::spawn(async move {
            tokio::net::TcpStream::connect(addr).await.unwrap()
        });

        let (_, _) = listener.accept().await.unwrap();
        let stream = connect_handle.await.unwrap();

        let peer_handshake = Handshake::new([0xAB; 20], [0xCD; 20]);
        PeerConnection::new(stream, addr, &peer_handshake, num_pieces)
    }

    #[tokio::test]
    async fn handle_incoming_unchoke_sets_peer_choking_false() {
        let mut conn = create_test_peer_connection(100).await;

        // Initially peer_choking is true
