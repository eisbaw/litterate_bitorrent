    #[tokio::test]
    async fn handle_incoming_piece_stores_block() {
        use crate::pieces::{InProgressPiece, BlockRequest};
        use sha1::{Sha1, Digest};

        let mut conn = create_test_peer_connection(100).await;
        let peer_id = conn.peer_id;

        // Create a small piece (1000 bytes, fits in one block)
        let piece_size = 1000u32;
        let mut in_progress = InProgressPiece::new(0, piece_size);

        // Create block data
        let block_data = vec![42u8; piece_size as usize];

        // Compute expected hash for verification
        let mut hasher = Sha1::new();
        hasher.update(&block_data);
        let hash_result = hasher.finalize();
        let mut expected_hash = [0u8; 20];
        expected_hash.copy_from_slice(&hash_result);

        // Add matching pending request
        conn.state.pending_requests.push_back(BlockRequest {
            piece_index: 0,
            offset: 0,
            length: piece_size,
            requested_at: std::time::Instant::now(),
            peer: peer_id,
        });

        assert_eq!(conn.state.pending_requests.len(), 1);

        // Call handler - piece will be complete after this block
        let result = handle_incoming_piece(
            &mut conn,
            0,      // index
            0,      // begin
            &block_data,
            &mut in_progress,
            &expected_hash,
        );

        // Should verify successfully since we computed the correct hash
        assert_eq!(result, PieceHandleResult::PieceVerified(0));
        assert!(conn.state.pending_requests.is_empty(), "pending request should be removed");
    }

