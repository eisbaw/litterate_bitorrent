    #[test]
    fn handle_incoming_bitfield_updates_availability() {
        use crate::pieces::{PieceManager, PieceAvailability};

        let mut peer_state = PeerState::new(8);
        let mut availability = PieceAvailability::new(8);
        let hashes = vec![[0u8; 20]]; // 1 piece
        let manager = PieceManager::new(100, 100, hashes).unwrap();

        // Before: all availability counts are 0
        for i in 0..8 {
            assert_eq!(availability.get_availability(i), Some(0));
        }

        // Peer has pieces 0, 2, 4, 6 (0b10101010)
        let bits = vec![0b10101010];
        let result = handle_incoming_bitfield(
            &mut peer_state,
            &bits,
            &mut availability,
            &manager,
        );
        assert!(result.is_ok());

        // Verify availability was updated for pieces the peer has
        assert_eq!(availability.get_availability(0), Some(1));
        assert_eq!(availability.get_availability(1), Some(0));
        assert_eq!(availability.get_availability(2), Some(1));
        assert_eq!(availability.get_availability(3), Some(0));
        assert_eq!(availability.get_availability(4), Some(1));
        assert_eq!(availability.get_availability(5), Some(0));
        assert_eq!(availability.get_availability(6), Some(1));
        assert_eq!(availability.get_availability(7), Some(0));
    }

    #[test]
    fn handle_incoming_have_updates_availability() {
        use crate::pieces::{PieceManager, PieceAvailability};

        let mut peer_state = PeerState::new(8);
        let mut availability = PieceAvailability::new(8);
        let hashes = vec![[0u8; 20]]; // 1 piece
        let manager = PieceManager::new(100, 100, hashes).unwrap();

        // Before: piece 3 has availability 0
        assert_eq!(availability.get_availability(3), Some(0));

        // Peer announces they have piece 3
        let result = handle_incoming_have(
            &mut peer_state,
            3,
            &mut availability,
            &manager,
        );

        // Should return true because we need piece 3 (manager has only piece 0)
        // Actually, manager only tracks 1 piece (index 0), so piece 3 is out of range for manager
        // but we still update availability and peer_state. is_verified returns false for
        // out-of-range indices, so this should return true.
        assert!(result);
        assert!(peer_state.has_piece(3));
        assert_eq!(availability.get_availability(3), Some(1));
    }

