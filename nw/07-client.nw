\subsection{Event Loop Tests}

We test the event loop with unit tests for message ordering and integration
tests for concurrent peer events.

<<event loop tests>>=
#[cfg(test)]
mod event_loop_tests {
    use super::*;
    use std::net::SocketAddr;

    #[test]
    fn event_loop_action_equality() {
        assert_eq!(EventLoopAction::Continue, EventLoopAction::Continue);
        assert_eq!(EventLoopAction::ShutdownRequested, EventLoopAction::ShutdownRequested);
        assert_eq!(EventLoopAction::Complete, EventLoopAction::Complete);
        assert_eq!(
            EventLoopAction::Error("test".to_string()),
            EventLoopAction::Error("test".to_string())
        );
        assert_ne!(EventLoopAction::Continue, EventLoopAction::ShutdownRequested);
    }

    #[test]
    fn event_loop_event_debug() {
        let event = EventLoopEvent::Shutdown;
        let debug_str = format!("{:?}", event);
        assert!(debug_str.contains("Shutdown"));

        let addr: SocketAddr = "127.0.0.1:6881".parse().unwrap();
        let event = EventLoopEvent::PeerMessage {
            addr,
            message: Ok(Message::KeepAlive),
        };
        let debug_str = format!("{:?}", event);
        assert!(debug_str.contains("PeerMessage"));
        assert!(debug_str.contains("127.0.0.1:6881"));
    }

    #[test]
    fn constants_are_reasonable() {
        // Request timeout should be longer than network round-trip
        assert!(REQUEST_TIMEOUT_CHECK_INTERVAL_SECS >= 10);
        assert!(REQUEST_TIMEOUT_CHECK_INTERVAL_SECS <= 60);

        // Pipeline length should allow good throughput
        assert!(DEFAULT_MAX_PIPELINE_LENGTH >= 5);
        assert!(DEFAULT_MAX_PIPELINE_LENGTH <= 20);
    }

    #[tokio::test]
    async fn read_from_first_peer_returns_none_for_empty() {
        let mut connections: HashMap<SocketAddr, PeerConnection> = HashMap::new();
        let result = read_from_first_peer(&mut connections).await;
        assert!(result.is_none());
    }
}
