    #[tokio::test]
    async fn disconnect_cleanup_removes_request_queue() {
        let addr: SocketAddr = "127.0.0.1:6881".parse().unwrap();
        let mut request_queues: HashMap<SocketAddr, PeerRequestQueue> = HashMap::new();

        // Create a queue with some requests
        let mut queue = PeerRequestQueue::new(10);
        let peer_id = *b"-LB0001-test12345678";
        queue.push(BlockRequest::new(0, 0, 16384, peer_id));
        queue.push(BlockRequest::new(0, 16384, 16384, peer_id));
        request_queues.insert(addr, queue);

        assert!(request_queues.contains_key(&addr));
        assert_eq!(request_queues.get(&addr).unwrap().len(), 2);

        // Remove and drain queue
        let removed = request_queues.remove(&addr);
        assert!(removed.is_some());

        let mut queue = removed.unwrap();
        let drained: Vec<_> = queue.drain().collect();
        assert_eq!(drained.len(), 2);

        // Verify queue is gone
        assert!(!request_queues.contains_key(&addr));
    }

