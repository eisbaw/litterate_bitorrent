    #[test]
    fn choking_decision_interested_and_choking_should_unchoke() {
        // AC #5: Unit test that verifies the choking decision logic.
        // When a peer is interested and we are choking them, we should unchoke.
        let mut state = PeerState::new(100);

        // Initial state: we choke by default, peer not interested by default
        assert!(state.am_choking, "Should start choking");
        assert!(!state.peer_interested, "Should start not interested");

        // Peer becomes interested (simulates receiving Interested message)
        state.handle_interested();
        assert!(state.peer_interested);
        assert!(state.am_choking);

        // The condition for unchoking: peer_interested && am_choking
        let should_unchoke = state.peer_interested && state.am_choking;
        assert!(should_unchoke, "Should unchoke interested peers we are choking");

        // After sending Unchoke, we update am_choking
        state.am_choking = false;

        // Now verify the condition no longer holds
        let should_unchoke_again = state.peer_interested && state.am_choking;
        assert!(!should_unchoke_again, "Should not unchoke again (already unchoked)");
    }

    #[test]
    fn choking_decision_not_interested_and_unchoked_should_choke() {
        // Test the optional optimization: choke peers that become uninterested
        let mut state = PeerState::new(100);

        // Simulate a peer we previously unchoked
        state.am_choking = false;
        state.peer_interested = true;

        // Peer becomes uninterested
        state.handle_not_interested();
        assert!(!state.peer_interested);
        assert!(!state.am_choking);

        // The condition for choking: !peer_interested && !am_choking
        let should_choke = !state.peer_interested && !state.am_choking;
        assert!(should_choke, "Should choke uninterested peers we are not choking");

        // After sending Choke, we update am_choking
        state.am_choking = true;

        // Verify the condition no longer holds
        let should_choke_again = !state.peer_interested && !state.am_choking;
        assert!(!should_choke_again, "Should not choke again (already choking)");
    }

