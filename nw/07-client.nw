        let request = BlockRequest::new(0, 0, 16384, test_peer_id());
        let addr: SocketAddr = "127.0.0.1:6881".parse().unwrap();
        let mut queue = PeerRequestQueue::new(10);

        // Add the request to the queue
        queue.push(request.clone());
        assert_eq!(queue.len(), 1, "Queue should have 1 request before timeout handling");

        let peers: HashMap<SocketAddr, PeerConnection> = HashMap::new();

