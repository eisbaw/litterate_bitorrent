use crate::messages::{Handshake, PeerError};
use tokio::io::{AsyncReadExt, AsyncWriteExt};
use tokio::net::TcpStream;
use tokio::time::timeout;

/// Default maximum number of concurrent peer connections.
///
/// The BitTorrent protocol benefits from connecting to many peers
/// simultaneously to maximize download parallelism. However, too many
/// connections can exhaust system resources (file descriptors, memory)
/// and overwhelm the network stack.
///
/// 30 is a common default that balances parallelism with resource usage.
/// This can be configured per-manager if needed.
pub const DEFAULT_MAX_CONNECTIONS: usize = 30;

/// Timeout in seconds for establishing TCP connections.
///
/// If a peer doesn't respond within this time, the connection attempt
/// fails with `PeerError::Timeout`. The PRD specifies 10 seconds.
pub const CONNECT_TIMEOUT_SECS: u64 = 10;

/// Timeout in seconds for completing the BitTorrent handshake exchange.
///
/// After establishing a TCP connection, both peers must exchange 68-byte
/// handshakes. If this exchange is not completed within HANDSHAKE_TIMEOUT_SECS,
/// the connection is considered failed. This timeout covers both sending our
/// handshake and receiving the peer's response.
///
/// The 10-second timeout matches the connection timeout and is sufficient
/// for peers on high-latency networks while preventing indefinite blocking
/// on unresponsive or malicious peers.
pub const HANDSHAKE_TIMEOUT_SECS: u64 = 10;

/// Establishes a TCP connection to a peer with timeout.
///
/// Uses a 10-second timeout to prevent hanging on unresponsive peers.
/// The timeout is configurable via the `CONNECT_TIMEOUT_SECS` constant.
///
/// # Why Timeouts Matter
///
/// BitTorrent peers are unreliable by nature. A peer address from the tracker
/// might be:
/// - Offline (machine powered down)
/// - Behind a firewall that drops packets silently
/// - On a slow or congested network
/// - Running but not accepting connections
///
/// Without a timeout, `TcpStream::connect` could block indefinitely waiting
/// for a response that never comes. The OS typically has a very long default
/// timeout (often 2+ minutes). A 10-second timeout is long enough for legitimate
/// connections over slow networks but short enough to move on to other peers
/// when one is unresponsive.
///
/// # Arguments
///
/// * `addr` - The socket address of the peer to connect to
///
/// # Returns
///
/// * `Ok(TcpStream)` - A connected TCP stream ready for the handshake
/// * `Err(PeerError::Timeout)` - Connection not established within 10 seconds
/// * `Err(PeerError::IoError)` - Other connection failures (refused, unreachable)
///
/// # Example
///
/// ```no_run
/// use std::net::SocketAddr;
/// use literate_bittorrent::client::connect_with_timeout;
///
/// async fn example() {
///     let addr: SocketAddr = "192.168.1.1:6881".parse().unwrap();
///     match connect_with_timeout(addr).await {
///         Ok(stream) => println!("Connected to {}", addr),
///         Err(e) => println!("Failed to connect: {}", e),
///     }
/// }
/// ```
pub async fn connect_with_timeout(addr: SocketAddr) -> Result<TcpStream, PeerError> {
    let connect_timeout = Duration::from_secs(CONNECT_TIMEOUT_SECS);

    match timeout(connect_timeout, TcpStream::connect(addr)).await {
        Ok(Ok(stream)) => Ok(stream),
        Ok(Err(io_err)) => Err(PeerError::IoError(io_err)),
        Err(_elapsed) => Err(PeerError::Timeout),
    }
}

/// Performs the BitTorrent handshake exchange with a peer.
///
/// After establishing a TCP connection, both peers must exchange handshakes
/// before any other messages can be sent. The handshake exchange consists of:
///
/// 1. **Send our handshake**: We transmit our 68-byte handshake containing
///    our info_hash (identifying the torrent) and peer_id (identifying us).
///
/// 2. **Receive peer's handshake**: We read exactly 68 bytes containing the
///    peer's info_hash and peer_id.
///
/// 3. **Validate**: We verify the peer's handshake has the correct protocol
///    string ("BitTorrent protocol") and matching info_hash.
///
/// # Timeout Behavior
///
/// The entire handshake exchange must complete within `HANDSHAKE_TIMEOUT_SECS`
/// (10 seconds). This timeout covers both the send and receive operations.
/// Without a timeout, a malicious or buggy peer could accept the connection
/// but never respond, causing our client to block indefinitely.
///
/// # Protocol Details
///
/// The BitTorrent handshake is symmetric: both sides send identical 68-byte
/// messages simultaneously. The protocol doesn't mandate who sends first;
/// we choose to send then receive, which is the common implementation.
///
/// # Validation
///
/// Two validations are performed on the received handshake:
///
/// 1. **Protocol validation** (in `Handshake::from_bytes`): Verifies the
///    protocol string length (19) and content ("BitTorrent protocol").
///
/// 2. **Info hash validation** (in `validate_info_hash`): Ensures the peer
///    is serving the same torrent. If info_hash differs, the peer is either
///    misconfigured or malicious.
///
/// # Arguments
///
/// * `stream` - The TCP stream to the peer (must be connected)
/// * `our_handshake` - Our handshake to send
/// * `expected_info_hash` - The info_hash we expect from the peer
///
/// # Returns
///
/// The peer's `Handshake` on success, containing their peer_id.
///
/// # Errors
///
/// * `PeerError::Timeout` - Handshake not completed within HANDSHAKE_TIMEOUT_SECS
/// * `PeerError::ConnectionClosed` - Peer closed connection during handshake (partial handshake)
/// * `PeerError::IoError` - Network error during read/write (connection refused, broken pipe, etc.)
/// * `PeerError::HandshakeFailed` - Invalid protocol or info_hash mismatch
///
/// # Example
///
/// ```no_run
/// use std::net::SocketAddr;
/// use literate_bittorrent::client::{connect_with_timeout, perform_handshake};
/// use literate_bittorrent::messages::Handshake;
///
/// async fn connect_and_handshake(addr: SocketAddr, info_hash: [u8; 20], peer_id: [u8; 20]) {
///     // First, establish TCP connection
///     let mut stream = connect_with_timeout(addr).await.unwrap();
///
///     // Create our handshake
///     let our_handshake = Handshake::new(info_hash, peer_id);
///
///     // Perform the handshake exchange
///     match perform_handshake(&mut stream, &our_handshake, &info_hash).await {
///         Ok(peer_handshake) => {
///             println!("Handshake successful! Peer ID: {:?}", peer_handshake.peer_id());
///         }
///         Err(e) => {
///             println!("Handshake failed: {}", e);
///         }
///     }
/// }
/// ```
pub async fn perform_handshake(
    stream: &mut TcpStream,
    our_handshake: &Handshake,
    expected_info_hash: &[u8; 20],
) -> Result<Handshake, PeerError> {
    let handshake_timeout = Duration::from_secs(HANDSHAKE_TIMEOUT_SECS);

    let handshake_future = async {
        // Send our handshake
        let our_bytes = our_handshake.to_bytes();
        match stream.write_all(&our_bytes).await {
            Ok(_) => {}
            Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => {
                return Err(PeerError::ConnectionClosed);
            }
            Err(e) => return Err(PeerError::IoError(e)),
        }

        // Read peer's handshake (exactly 68 bytes)
        // If connection closes mid-handshake (e.g., only 30 of 68 bytes received),
        // read_exact returns UnexpectedEof which we convert to ConnectionClosed.
        let mut peer_bytes = [0u8; 68];
        match stream.read_exact(&mut peer_bytes).await {
            Ok(_) => {}
            Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => {
                return Err(PeerError::ConnectionClosed);
            }
            Err(e) => return Err(PeerError::IoError(e)),
        }

        // Parse and validate
        let peer_handshake = Handshake::from_bytes(&peer_bytes)?;
        peer_handshake.validate_info_hash(expected_info_hash)?;

        Ok::<Handshake, PeerError>(peer_handshake)
    };

    match timeout(handshake_timeout, handshake_future).await {
        Ok(result) => result,
        Err(_elapsed) => Err(PeerError::Timeout),
    }
}

