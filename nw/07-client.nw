use crate::pieces::{PieceAvailability, InProgressPiece, verify_piece};

/// Handles an incoming bitfield message from a peer.
///
/// This function performs the full integration of a bitfield message:
/// 1. Updates the peer's bitfield in their PeerState
/// 2. Updates the global PieceAvailability for each piece the peer has
/// 3. Determines if we should become interested in this peer
///
/// # Arguments
///
/// * `peer_state` - The peer's connection state to update
/// * `bits` - The raw bitfield bytes from the peer
/// * `availability` - Global piece availability tracker
/// * `piece_manager` - Manager tracking our piece download state
///
/// # Returns
///
/// * `Ok(true)` if we should send an Interested message to this peer
/// * `Ok(false)` if we should not become interested
/// * `Err(PeerError)` if the bitfield was invalid (wrong length)
///
/// # Example
///
/// ```
/// use literate_bittorrent::client::{PeerState, handle_incoming_bitfield};
/// use literate_bittorrent::pieces::{PieceManager, PieceAvailability};
///
/// let mut peer_state = PeerState::new(8);
/// let mut availability = PieceAvailability::new(8);
/// let hashes = vec![[0u8; 20]];
/// let manager = PieceManager::new(100, 100, hashes).unwrap();
///
/// // Peer has piece 0 (0b10000000)
/// let bits = vec![0b10000000];
/// let should_be_interested = handle_incoming_bitfield(
///     &mut peer_state,
///     &bits,
///     &mut availability,
///     &manager,
/// ).unwrap();
///
/// assert!(peer_state.has_piece(0));
/// assert_eq!(availability.get_availability(0), Some(1));
/// assert!(should_be_interested); // We need piece 0
/// ```
pub fn handle_incoming_bitfield(
    peer_state: &mut PeerState,
    bits: &[u8],
    availability: &mut PieceAvailability,
    piece_manager: &PieceManager,
) -> Result<bool, crate::messages::PeerError> {
    // First, update the peer's bitfield
    peer_state.handle_bitfield(bits)?;

    // Update global availability for each piece the peer has
    let num_pieces = availability.num_pieces();
    for piece_index in 0..num_pieces {
        if peer_state.has_piece(piece_index as u32) {
            availability.add_piece(piece_index as u32);
        }
    }

    // Determine if we should be interested: does the peer have any piece we need?
    let should_be_interested = (0..num_pieces).any(|i| {
        peer_state.has_piece(i as u32) && !piece_manager.is_verified(i)
    });

    Ok(should_be_interested)
}

/// Handles an incoming have message from a peer.
///
/// This function performs the full integration of a have message:
/// 1. Updates the peer's bitfield to mark the piece as available
/// 2. Increments the global PieceAvailability for that piece
/// 3. Determines if we should become interested in this peer
///
/// Unlike bitfield messages, have messages cannot fail (invalid indices
/// are simply ignored). This matches the BitTorrent protocol behavior where
/// clients typically ignore malformed have messages rather than disconnecting.
///
/// # Arguments
///
/// * `peer_state` - The peer's connection state to update
/// * `piece_index` - The piece index the peer now has
/// * `availability` - Global piece availability tracker
/// * `piece_manager` - Manager tracking our piece download state
///
/// # Returns
///
/// * `true` if we should send an Interested message (peer has a piece we need)
/// * `false` if we don't need this piece or the index was invalid
///
/// # Example
///
/// ```
/// use literate_bittorrent::client::{PeerState, handle_incoming_have};
/// use literate_bittorrent::pieces::{PieceManager, PieceAvailability};
///
/// let mut peer_state = PeerState::new(8);
/// let mut availability = PieceAvailability::new(8);
/// let hashes = vec![[0u8; 20]];
/// let manager = PieceManager::new(100, 100, hashes).unwrap();
///
/// let should_be_interested = handle_incoming_have(
///     &mut peer_state,
///     0,
///     &mut availability,
///     &manager,
/// );
///
/// assert!(peer_state.has_piece(0));
/// assert_eq!(availability.get_availability(0), Some(1));
/// assert!(should_be_interested); // We need piece 0
/// ```
pub fn handle_incoming_have(
    peer_state: &mut PeerState,
    piece_index: u32,
    availability: &mut PieceAvailability,
    piece_manager: &PieceManager,
) -> bool {
    // Update peer's bitfield (returns false if index invalid)
    if !peer_state.handle_have(piece_index) {
        return false;
    }

    // Update global availability
    availability.add_piece(piece_index);

    // Check if we need this piece
    !piece_manager.is_verified(piece_index as usize)
}

/// Formats a peer_id for logging (shows first 8 bytes as hex).
///
/// Peer IDs are 20 bytes, but showing all of them clutters logs.
/// The first 8 bytes typically contain the client identifier (e.g., "-LB0001-")
/// which is sufficient for distinguishing peers in most cases.
///
/// # Example
///
/// ```
/// use literate_bittorrent::client::format_peer_id;
///
/// let peer_id = *b"-LB0001-XXXXXXXXXXXX";
/// let formatted = format_peer_id(&peer_id);
/// assert_eq!(formatted, "2d4c42303030312d"); // "-LB0001-" in hex
/// ```
pub fn format_peer_id(peer_id: &[u8; 20]) -> String {
    use std::fmt::Write;
    peer_id.iter().take(8).fold(String::with_capacity(16), |mut s, b| {
        let _ = write!(s, "{:02x}", b);
        s
    })
}

/// Handles an incoming unchoke message from a peer.
///
/// Updates peer state and logs the transition. Unchoke messages indicate
/// that the remote peer is willing to respond to our block requests.
/// After receiving an unchoke, the caller should start sending block
/// requests to this peer if we are interested in their pieces.
///
/// # Flow Control
///
/// In BitTorrent, choke/unchoke messages control data transfer flow:
/// - A choked peer will not receive piece data
/// - An unchoked peer may request and receive blocks
///
/// This function logs the transition at INFO level to aid debugging
/// of slow downloads. When a download stalls, the logs can reveal
/// whether peers are choking us.
///
/// # Arguments
///
/// * `conn` - The peer connection to update
///
/// # Example
///
/// ```no_run
/// use literate_bittorrent::client::{PeerConnection, handle_incoming_unchoke};
///
/// fn process_unchoke(conn: &mut PeerConnection) {
///     handle_incoming_unchoke(conn);
///     // Now we can request blocks from this peer
///     // (if conn.state.am_interested is true)
/// }
/// ```
pub fn handle_incoming_unchoke(conn: &mut PeerConnection) {
    let was_choked = conn.state.peer_choking;
    conn.state.handle_unchoke();

    if was_choked {
        info!(
            peer_id = %format_peer_id(&conn.peer_id),
            addr = %conn.addr,
            "peer unchoked us - can request blocks"
        );
    }
}

/// Handles an incoming choke message from a peer.
///
/// Updates peer state, cancels pending requests, and logs the transition.
/// Choke messages indicate that the remote peer will no longer respond
/// to our block requests. Any pending requests must be considered lost.
///
/// # Request Reassignment
///
/// When a peer chokes us, all pending block requests to that peer are
/// effectively cancelled. Rather than losing these requests, this function
/// returns them so the caller can reassign them to other unchoked peers.
/// This prevents download stalls when peers choke us mid-transfer.
///
/// The pending requests are drained from the connection state before
/// calling `handle_choke()` to ensure they are captured before being
/// cleared.
///
/// # Arguments
///
/// * `conn` - The peer connection to update
///
/// # Returns
///
/// A vector of the pending block requests that were cancelled.
/// These should be returned to the scheduler for reassignment to
/// other peers who have the same pieces.
///
/// # Example
///
/// ```no_run
/// use literate_bittorrent::client::{PeerConnection, handle_incoming_choke};
///
/// fn process_choke(conn: &mut PeerConnection) {
///     let cancelled = handle_incoming_choke(conn);
///     // Return cancelled requests to the piece manager for reassignment
///     for request in cancelled {
///         // scheduler.return_request(request);
///     }
/// }
/// ```
pub fn handle_incoming_choke(conn: &mut PeerConnection) -> Vec<BlockRequest> {
    let was_unchoked = !conn.state.peer_choking;

    // Drain pending requests before handle_choke clears them
    let cancelled: Vec<BlockRequest> = conn.state.pending_requests.drain(..).collect();

    conn.state.handle_choke();

    if was_unchoked {
        info!(
            peer_id = %format_peer_id(&conn.peer_id),
            addr = %conn.addr,
            cancelled_requests = cancelled.len(),
            "peer choked us - requests cancelled"
        );
    }

    cancelled
}
