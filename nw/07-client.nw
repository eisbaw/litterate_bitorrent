    fn handle_bitfield_rejects_wrong_length() {
        use crate::messages::PeerError;

        let mut state = PeerState::new(16); // Expects 2 bytes

        // Too short
        let short_bits = vec![0xFF];
        let result = state.handle_bitfield(&short_bits);
        assert!(matches!(result, Err(PeerError::BitfieldWrongLength { expected: 2, actual: 1 })));

        // Too long
        let long_bits = vec![0xFF, 0xFF, 0xFF];
        let result = state.handle_bitfield(&long_bits);
        assert!(matches!(result, Err(PeerError::BitfieldWrongLength { expected: 2, actual: 3 })));
    }

    #[test]
    fn handle_bitfield_preserves_partial_last_byte() {
        // 10 pieces = 2 bytes (with 6 unused bits in last byte)
        let mut state = PeerState::new(10);

        // Set first 10 bits, leave unused bits as 0
        let bits = vec![0xFF, 0b1100_0000]; // 8 + 2 = 10 pieces set
        let result = state.handle_bitfield(&bits);
        assert!(result.is_ok());

        // Verify the 10 valid pieces
        for i in 0..10 {
            assert!(state.has_piece(i), "Piece {} should be set", i);
        }
    }
}
@

