        conn.state.peer_choking = false;
        assert!(!conn.state.peer_choking);

        handle_incoming_choke(&mut conn);

        assert!(conn.state.peer_choking, "handle_incoming_choke should set peer_choking to true");
    }

    #[tokio::test]
    async fn handle_incoming_choke_returns_cancelled_requests() {
        use crate::pieces::BlockRequest;
        use std::time::Instant;

        let mut conn = create_test_peer_connection(100).await;
        conn.state.peer_choking = false;

        let now = Instant::now();
        let peer_id = conn.peer_id;

        // Add some pending requests
        conn.state.pending_requests.push_back(BlockRequest {
            piece_index: 0,
            offset: 0,
            length: 16384,
            requested_at: now,
            peer: peer_id,
        });
        conn.state.pending_requests.push_back(BlockRequest {
            piece_index: 1,
            offset: 0,
            length: 16384,
            requested_at: now,
            peer: peer_id,
        });
        conn.state.pending_requests.push_back(BlockRequest {
            piece_index: 2,
            offset: 16384,
            length: 16384,
            requested_at: now,
            peer: peer_id,
        });

        assert_eq!(conn.state.pending_requests.len(), 3);

        let cancelled = handle_incoming_choke(&mut conn);

        // Should return all cancelled requests
        assert_eq!(cancelled.len(), 3, "Should return all 3 cancelled requests");
        assert_eq!(cancelled[0].piece_index, 0);
        assert_eq!(cancelled[1].piece_index, 1);
        assert_eq!(cancelled[2].piece_index, 2);

        // pending_requests should now be empty
        assert!(conn.state.pending_requests.is_empty(), "pending_requests should be empty after choke");
    }

