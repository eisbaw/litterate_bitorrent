/// Represents a live connection to a peer.
///
/// Encapsulates the TCP stream, peer identity, protocol state, and timing
/// information for keep-alive and timeout management.
///
/// Note: Debug is implemented manually because TcpStream's Debug output
/// is not particularly useful for logging.
pub struct PeerConnection {
    /// The TCP stream for communication with this peer.
    pub stream: TcpStream,

    /// The socket address (IP:port) of this peer.
    pub addr: SocketAddr,

    /// The peer's 20-byte peer_id from their handshake.
    pub peer_id: [u8; 20],

    /// Per-peer protocol state (choke/interest state machine, bitfield).
    pub state: PeerState,

    /// When we last received a message from this peer.
    /// Used for idle timeout detection.
    pub last_recv_time: Instant,

    /// When we last sent a message to this peer.
    /// Used for keep-alive scheduling.
    pub last_send_time: Instant,
}

impl PeerConnection {
    /// Creates a new PeerConnection from a completed handshake.
    ///
    /// # Arguments
    ///
    /// * `stream` - The TCP stream (already connected and handshaked)
    /// * `addr` - The peer's socket address
    /// * `peer_handshake` - The handshake received from the peer
    /// * `num_pieces` - Number of pieces in the torrent (for bitfield sizing)
    ///
    /// # Example
    ///
    /// ```no_run
    /// use std::net::SocketAddr;
    /// use std::time::Instant;
    /// use tokio::net::TcpStream;
    /// use literate_bittorrent::messages::Handshake;
    /// use literate_bittorrent::client::PeerConnection;
    ///
    /// async fn example() {
    ///     let addr: SocketAddr = "192.168.1.1:6881".parse().unwrap();
    ///     let stream = TcpStream::connect(addr).await.unwrap();
    ///     let peer_handshake = Handshake::new([0xAB; 20], [0xCD; 20]);
    ///
    ///     let conn = PeerConnection::new(stream, addr, &peer_handshake, 100);
    ///
    ///     assert_eq!(conn.addr, addr);
    ///     assert_eq!(conn.peer_id, *peer_handshake.peer_id());
    /// }
    /// ```
    pub fn new(
        stream: TcpStream,
        addr: SocketAddr,
        peer_handshake: &Handshake,
        num_pieces: usize,
    ) -> Self {
        let now = Instant::now();
        Self {
            stream,
            addr,
            peer_id: *peer_handshake.peer_id(),
            state: PeerState::new(num_pieces as u32),
            last_recv_time: now,
            last_send_time: now,
        }
    }

    /// Updates the last receive time to now.
    ///
    /// Call this whenever a message is received from the peer.
    /// Used for idle timeout detection.
    pub fn mark_received(&mut self) {
        self.last_recv_time = Instant::now();
    }

    /// Updates the last send time to now.
    ///
    /// Call this whenever a message is sent to the peer.
    /// Used for keep-alive scheduling.
    pub fn mark_sent(&mut self) {
        self.last_send_time = Instant::now();
    }
}

impl std::fmt::Debug for PeerConnection {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("PeerConnection")
            .field("addr", &self.addr)
            .field("peer_id", &format_args!("{:02x?}", &self.peer_id[..8]))
            .field("state", &self.state)
            .field("last_recv_time", &self.last_recv_time)
            .field("last_send_time", &self.last_send_time)
            // Omit stream - it's not useful to print
            .finish_non_exhaustive()
    }
}

/// Manages the pool of active peer connections.
///
/// The `PeerConnectionManager` is responsible for:
/// - Tracking active connections and their state
/// - Maintaining a queue of available peer addresses
/// - Connecting to new peers when slots are available
/// - Providing access to peer state for message handling
///
/// # Connection Strategy
///
/// The manager implements a simple connection strategy:
/// 1. Maintain up to `max_connections` active connections
/// 2. When a slot is available and peers are queued, connect to the next one
/// 3. When a connection drops, it's removed and the slot becomes available
///
/// # Thread Safety
///
/// This struct is designed for single-threaded use within the main event loop.
/// For multi-threaded access, wrap in appropriate synchronization primitives.
///
/// # Example
///
/// ```
/// use std::net::SocketAddr;
/// use literate_bittorrent::client::{PeerConnectionManager, DEFAULT_MAX_CONNECTIONS};
///
/// let manager = PeerConnectionManager::new(
///     [0xAA; 20],  // our peer_id
///     [0xBB; 20],  // info_hash
///     100,         // num_pieces
///     DEFAULT_MAX_CONNECTIONS,
/// );
///
/// // Initially empty
/// assert_eq!(manager.active_count(), 0);
/// assert_eq!(manager.available_count(), 0);
/// ```
#[derive(Debug)]
pub struct PeerConnectionManager {
    /// Active peer connections, keyed by socket address.
    ///
    /// Using `HashMap` provides O(1) lookup and prevents duplicate
    /// connections to the same address.
    connections: HashMap<SocketAddr, PeerConnection>,

    /// Queue of peer addresses available for connection.
    ///
    /// These addresses came from tracker responses but we haven't
    /// connected to them yet. FIFO ordering ensures fairness.
    available_peers: VecDeque<SocketAddr>,

    /// Our 20-byte peer ID for handshakes.
    peer_id: [u8; 20],

    /// The 20-byte info hash for handshake validation.
    info_hash: [u8; 20],

    /// Number of pieces in the torrent.
    ///
    /// Used to size the bitfield in `PeerState` for new connections.
    num_pieces: usize,

    /// Maximum number of concurrent connections.
    max_connections: usize,
}

impl PeerConnectionManager {
    /// Creates a new PeerConnectionManager.
    ///
    /// # Arguments
    ///
    /// * `peer_id` - Our 20-byte peer ID for handshakes
    /// * `info_hash` - The 20-byte info hash for this torrent
    /// * `num_pieces` - Total number of pieces in the torrent
    /// * `max_connections` - Maximum number of concurrent connections
    ///
    /// # Example
    ///
    /// ```
    /// use literate_bittorrent::client::{PeerConnectionManager, DEFAULT_MAX_CONNECTIONS};
    ///
    /// let manager = PeerConnectionManager::new(
    ///     [0xAA; 20],
    ///     [0xBB; 20],
    ///     100,
    ///     DEFAULT_MAX_CONNECTIONS,
    /// );
    /// ```
    pub fn new(
        peer_id: [u8; 20],
        info_hash: [u8; 20],
        num_pieces: usize,
        max_connections: usize,
    ) -> Self {
        PeerConnectionManager {
            connections: HashMap::new(),
            available_peers: VecDeque::new(),
            peer_id,
            info_hash,
            num_pieces,
            max_connections,
        }
    }

    /// Adds peer addresses to the available queue.
    ///
    /// Addresses are added to the back of the queue (FIFO ordering).
    /// Duplicate addresses are filtered out: we skip any address that
    /// is already in the available queue or already connected.
    ///
    /// Returns the number of peers actually added (excluding duplicates).
    /// This allows callers to log useful information like "Added 3/10 peers
    /// from tracker (7 duplicates)".
    ///
    /// # Arguments
    ///
    /// * `peers` - Vector of socket addresses to add
    ///
    /// # Returns
    ///
    /// Number of peers actually added to the available queue.
    ///
    /// # Example
    ///
    /// ```
    /// use std::net::SocketAddr;
    /// use literate_bittorrent::client::{PeerConnectionManager, DEFAULT_MAX_CONNECTIONS};
    ///
    /// let mut manager = PeerConnectionManager::new(
    ///     [0xAA; 20],
    ///     [0xBB; 20],
    ///     100,
    ///     DEFAULT_MAX_CONNECTIONS,
    /// );
    ///
    /// let peers: Vec<SocketAddr> = vec![
    ///     "192.168.1.1:6881".parse().unwrap(),
    ///     "192.168.1.2:6881".parse().unwrap(),
    /// ];
    /// let added = manager.add_peers(peers);
    ///
    /// assert_eq!(added, 2);
    /// assert_eq!(manager.available_count(), 2);
    /// ```
    pub fn add_peers(&mut self, peers: Vec<SocketAddr>) -> usize {
        let mut added = 0;
        for addr in peers {
            // Skip if already connected
            if self.connections.contains_key(&addr) {
                continue;
            }
            // Skip if already in available queue.
            // Note: O(n) check on VecDeque. If profiling shows this is slow
            // with large peer lists, consider adding a HashSet for O(1) lookup.
            if self.available_peers.contains(&addr) {
                continue;
            }
            self.available_peers.push_back(addr);
            added += 1;
        }
        added
    }

    /// Returns the number of active connections.
    #[inline]
    pub fn active_count(&self) -> usize {
        self.connections.len()
    }

    /// Returns the number of available peer addresses.
    #[inline]
    pub fn available_count(&self) -> usize {
        self.available_peers.len()
    }

    /// Returns a reference to a connection by address.
    ///
    /// Returns `None` if we're not connected to this address.
    #[inline]
    pub fn get_connection(&self, addr: &SocketAddr) -> Option<&PeerConnection> {
        self.connections.get(addr)
    }

    /// Returns a mutable reference to a connection by address.
    ///
    /// Returns `None` if we're not connected to this address.
    #[inline]
    pub fn get_connection_mut(&mut self, addr: &SocketAddr) -> Option<&mut PeerConnection> {
        self.connections.get_mut(addr)
    }

    /// Removes and returns a connection by address.
    ///
    /// Returns `None` if we're not connected to this address.
    /// After removal, the slot becomes available for a new connection.
    pub fn remove_connection(&mut self, addr: &SocketAddr) -> Option<PeerConnection> {
        self.connections.remove(addr)
    }

    /// Returns true if we need (and can) connect to more peers.
    ///
    /// This returns true when:
    /// 1. We have fewer than `max_connections` active connections
    /// 2. There are available peer addresses to connect to
    ///
    /// The main event loop can use this to decide when to initiate
    /// new connections.
    #[inline]
    pub fn needs_more_connections(&self) -> bool {
        self.active_count() < self.max_connections && self.available_count() > 0
    }

    /// Registers an established peer connection.
    ///
    /// Call this after successfully connecting to a peer and completing
    /// the handshake. The connection is stored and managed for message
    /// exchange.
    ///
    /// # Arguments
    ///
    /// * `stream` - The TCP stream (already connected and handshaked)
    /// * `addr` - The peer's socket address
    /// * `peer_handshake` - The handshake received from the peer
    ///
    /// # Returns
    ///
    /// * `Ok(())` - Connection was registered successfully
    /// * `Err(PeerError::AlreadyConnected)` - Already connected to this address
    ///
    /// # Example
    ///
    /// ```no_run
    /// use std::net::SocketAddr;
    /// use tokio::net::TcpStream;
    /// use literate_bittorrent::messages::Handshake;
    /// use literate_bittorrent::client::{PeerConnectionManager, DEFAULT_MAX_CONNECTIONS};
    ///
    /// async fn example() {
    ///     let mut manager = PeerConnectionManager::new(
    ///         [0xAA; 20],
    ///         [0xBB; 20],
    ///         100,
    ///         DEFAULT_MAX_CONNECTIONS,
    ///     );
    ///
    ///     let addr: SocketAddr = "192.168.1.1:6881".parse().unwrap();
    ///     let stream = TcpStream::connect(addr).await.unwrap();
    ///     let peer_handshake = Handshake::new([0xBB; 20], [0xCC; 20]);
    ///
    ///     manager.register_connection(stream, addr, &peer_handshake).unwrap();
    ///
    ///     assert_eq!(manager.active_count(), 1);
    ///     assert!(manager.get_connection(&addr).is_some());
    /// }
    /// ```
    pub fn register_connection(
        &mut self,
        stream: TcpStream,
        addr: SocketAddr,
        peer_handshake: &Handshake,
    ) -> Result<(), PeerError> {
        // Check for duplicate connection
        if self.connections.contains_key(&addr) {
            return Err(PeerError::AlreadyConnected);
        }

        // Create the connection from the handshake result
        let conn = PeerConnection::new(stream, addr, peer_handshake, self.num_pieces);

        // Add to active connections
        self.connections.insert(addr, conn);

        Ok(())
    }

    /// Pops the next available peer address from the queue.
    ///
    /// Returns `None` if the available queue is empty.
    /// This is useful for the connection loop to get addresses
    /// to connect to.
    pub fn pop_available(&mut self) -> Option<SocketAddr> {
        self.available_peers.pop_front()
    }

    /// Returns our peer ID.
    #[inline]
    pub fn peer_id(&self) -> &[u8; 20] {
        &self.peer_id
    }

    /// Returns the info hash.
    #[inline]
    pub fn info_hash(&self) -> &[u8; 20] {
        &self.info_hash
    }

    /// Returns the maximum number of connections.
    #[inline]
    pub fn max_connections(&self) -> usize {
        self.max_connections
    }

    /// Returns an iterator over all active connections.
    pub fn connections(&self) -> impl Iterator<Item = (&SocketAddr, &PeerConnection)> {
        self.connections.iter()
    }

    /// Returns a mutable iterator over all active connections.
    pub fn connections_mut(&mut self) -> impl Iterator<Item = (&SocketAddr, &mut PeerConnection)> {
        self.connections.iter_mut()
    }
}
