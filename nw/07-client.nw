    /// Helper to create a minimal valid single-file torrent.
    fn make_test_metainfo(
        name: &str,
        total_length: u64,
        piece_length: u32,
        num_pieces: usize,
    ) -> Metainfo {
        // Create piece hashes (all zeros for testing)
        let piece_hashes: Vec<[u8; 20]> = vec![[0u8; 20]; num_pieces];

        // Compute a fake info hash
        let mut info = BTreeMap::new();
        info.insert(b"length".to_vec(), BencodeValue::Integer(total_length as i64));
        info.insert(b"name".to_vec(), BencodeValue::Bytes(name.as_bytes().to_vec()));
        info.insert(b"piece length".to_vec(), BencodeValue::Integer(piece_length as i64));
        info.insert(
            b"pieces".to_vec(),
            BencodeValue::Bytes(vec![0u8; num_pieces * 20]),
        );
        let info_value = BencodeValue::Dict(info);

        use sha1::{Sha1, Digest};
        let encoded = encode(&info_value);
        let mut hasher = Sha1::new();
        hasher.update(&encoded);
        let hash_result = hasher.finalize();
        let mut info_hash = [0u8; 20];
        info_hash.copy_from_slice(&hash_result);

        Metainfo {
            announce: "http://tracker.example.com/announce".to_string(),
            info_hash,
            piece_length,
            piece_hashes,
            total_length,
            files: vec![crate::metainfo::FileInfo {
                length: total_length,
                path: PathBuf::from(name),
            }],
            name: name.to_string(),
        }
    }

