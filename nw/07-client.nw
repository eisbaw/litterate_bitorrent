            &mut availability,
            &manager,
        );

        // Should return true because we need piece 3 (manager has only piece 0)
        // Actually, manager only tracks 1 piece (index 0), so piece 3 is out of range for manager
        // but we still update availability and peer_state. is_verified returns false for
        // out-of-range indices, so this should return true.
        assert!(result);
        assert!(peer_state.has_piece(3));
        assert_eq!(availability.get_availability(3), Some(1));
    }

