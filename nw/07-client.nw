\subsection{Integration Tests}

Integration tests verify the event loop handles concurrent peer events correctly:

<<event loop integration tests>>=
#[cfg(test)]
mod event_loop_integration_tests {
    use super::*;
    use std::sync::Arc;

    #[tokio::test]
    async fn shutdown_controller_triggers_event_loop_exit() {
        let shutdown = ShutdownController::new();

        // Request shutdown
        shutdown.request_shutdown();

        // Verify the check works
        assert!(shutdown.is_shutdown_requested());
    }

    #[tokio::test]
    async fn event_loop_respects_shutdown() {
        // This test verifies the event loop exits on shutdown
        // We create a minimal context and trigger shutdown

        let shutdown = Arc::new(ShutdownController::new());
        shutdown.request_shutdown();

        // The event loop should detect shutdown immediately
        assert!(shutdown.is_shutdown_requested());
    }
}
