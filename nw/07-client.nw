\subsection{Client Construction}

Creating a [[Client]] requires a parsed [[Metainfo]] and configuration options.
The constructor initializes the piece manager from the torrent metadata and
generates a fresh peer ID.

<<client impl>>=
/// Errors that can occur when constructing a Client.
#[derive(Debug, thiserror::Error)]
pub enum ClientError {
    /// Failed to initialize the piece manager.
    #[error("piece manager initialization failed: {0}")]
    PieceManagerError(#[from] crate::pieces::PieceError),
}

impl Client {
    /// Creates a new Client for downloading a torrent.
    ///
    /// # Arguments
    ///
    /// * `metainfo` - Parsed torrent metadata
    /// * `output_dir` - Directory where files will be saved
    /// * `port` - TCP port for incoming peer connections
    ///
    /// # Returns
    ///
    /// * `Ok(Client)` on success
    /// * `Err(ClientError)` if piece manager initialization fails
    ///
    /// # Example
    ///
    /// ```no_run
    /// use std::path::PathBuf;
    /// use literate_bittorrent::client::Client;
    /// use literate_bittorrent::metainfo;
    ///
    /// let data = std::fs::read("test.torrent").unwrap();
    /// let metainfo = metainfo::parse(&data).unwrap();
    /// let client = Client::new(metainfo, PathBuf::from("."), 6881).unwrap();
    /// ```
    pub fn new(
        metainfo: Metainfo,
        output_dir: PathBuf,
        port: u16,
    ) -> Result<Self, ClientError> {
        // Initialize piece manager from torrent metadata
        let piece_manager = PieceManager::new(
            metainfo.piece_length,
            metainfo.total_length,
            metainfo.piece_hashes.clone(),
        )?;

        // Cache the info hash for frequent access
        let info_hash = metainfo.info_hash;

        // Generate our peer ID
        let peer_id = generate_peer_id();

        // Get a handle to the current Tokio runtime
        // This will panic if called outside a Tokio context, which is
        // acceptable since the client is designed for async operation
        let runtime_handle = tokio::runtime::Handle::current();

        Ok(Client {
            metainfo,
            info_hash,
            peer_id,
            piece_manager,
            output_dir,
            port,
            active_peers: HashMap::new(),
            runtime_handle,
            start_time: std::time::Instant::now(),
            download_complete: false,
            completed_announced: false,
        })
    }

    /// Creates a new Client for testing without requiring a Tokio runtime.
    ///
    /// This constructor is identical to `new()` except it creates its own
    /// single-threaded runtime. Use this only for unit tests that don't
    /// need the runtime for async operations.
    #[cfg(test)]
    pub fn new_for_test(
        metainfo: Metainfo,
        output_dir: PathBuf,
        port: u16,
    ) -> Result<Self, ClientError> {
        let piece_manager = PieceManager::new(
            metainfo.piece_length,
            metainfo.total_length,
            metainfo.piece_hashes.clone(),
        )?;

        let info_hash = metainfo.info_hash;
        let peer_id = generate_peer_id();

        // Create a minimal runtime for testing
        let runtime = tokio::runtime::Builder::new_current_thread()
            .enable_all()
            .build()
            .expect("Failed to create test runtime");
        let runtime_handle = runtime.handle().clone();

        // Leak the runtime to keep the handle valid
        // This is acceptable in tests where we don't care about cleanup
        std::mem::forget(runtime);

        Ok(Client {
            metainfo,
            info_hash,
            peer_id,
            piece_manager,
            output_dir,
            port,
            active_peers: HashMap::new(),
            runtime_handle,
            start_time: std::time::Instant::now(),
            download_complete: false,
            completed_announced: false,
        })
    }

    // ========================================================================
    // Accessor methods
    // ========================================================================

    /// Returns the torrent name.
    ///
    /// For single-file torrents, this is the filename.
    /// For multi-file torrents, this is the root directory name.
    #[inline]
    pub fn name(&self) -> &str {
        &self.metainfo.name
    }

    /// Returns the 20-byte info hash identifying this torrent.
    #[inline]
    pub fn info_hash(&self) -> &[u8; 20] {
        &self.info_hash
    }

    /// Returns our 20-byte peer ID.
    #[inline]
    pub fn peer_id(&self) -> &[u8; 20] {
        &self.peer_id
    }

    /// Returns a reference to the piece manager.
    #[inline]
    pub fn piece_manager(&self) -> &PieceManager {
        &self.piece_manager
    }

    /// Returns a mutable reference to the piece manager.
    #[inline]
    pub fn piece_manager_mut(&mut self) -> &mut PieceManager {
        &mut self.piece_manager
    }

    /// Returns the output directory path.
    #[inline]
    pub fn output_dir(&self) -> &PathBuf {
        &self.output_dir
    }

    /// Returns the listen port.
    #[inline]
    pub fn port(&self) -> u16 {
        self.port
    }

    /// Returns the tracker announce URL.
    #[inline]
    pub fn announce_url(&self) -> &str {
        &self.metainfo.announce
    }

    /// Returns a reference to the full metainfo.
    #[inline]
    pub fn metainfo(&self) -> &Metainfo {
        &self.metainfo
    }

    /// Returns the number of pieces in this torrent.
    #[inline]
    pub fn num_pieces(&self) -> u32 {
        self.piece_manager.num_pieces()
    }

    /// Returns the total content size in bytes.
    #[inline]
    pub fn total_length(&self) -> u64 {
        self.metainfo.total_length
    }

    /// Returns the number of currently connected peers.
    #[inline]
    pub fn num_peers(&self) -> usize {
        self.active_peers.len()
    }

    /// Returns a handle to the Tokio runtime.
    #[inline]
    pub fn runtime_handle(&self) -> &tokio::runtime::Handle {
        &self.runtime_handle
    }

    /// Returns the time when the download started.
    #[inline]
    pub fn start_time(&self) -> std::time::Instant {
        self.start_time
    }

    /// Returns true if the download is complete.
    ///
    /// This flag is set when all pieces have been verified. Once set,
    /// no further piece requests should be made.
    #[inline]
    pub fn is_download_complete(&self) -> bool {
        self.download_complete
    }

    /// Returns true if the completed event has been announced to the tracker.
    #[inline]
    pub fn is_completed_announced(&self) -> bool {
        self.completed_announced
    }
}
@

The accessor methods provide read-only access to internal state, following Rust's
ownership principles. The [[piece\_manager\_mut]] method allows subsystems to
update piece state during downloads.

