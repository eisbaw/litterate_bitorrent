\subsection{Peer Request Queue Tests}

The [[PeerRequestQueue]] must correctly enforce its capacity limit and maintain
FIFO ordering. These tests verify the core operations.

<<peer request queue tests>>=
#[cfg(test)]
mod peer_request_queue_tests {
    use super::*;
    use crate::pieces::BlockRequest;

    fn make_request(piece_index: u32, offset: u32) -> BlockRequest {
        let peer_id = *b"-LB0001-test12345678";
        BlockRequest::new(piece_index, offset, 16384, peer_id)
    }

    #[test]
    fn peer_request_queue_rejects_when_full() {
        let mut queue = PeerRequestQueue::new(2);
        assert!(queue.push(make_request(0, 0)));
        assert!(queue.push(make_request(0, 16384)));
        assert!(!queue.push(make_request(1, 0))); // rejected
        assert!(queue.is_full());
    }

    #[test]
    fn peer_request_queue_remove_finds_matching() {
        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));
        queue.push(make_request(1, 0));

        let removed = queue.remove(1, 0);
        assert!(removed.is_some());
        assert_eq!(removed.unwrap().request.piece_index, 1);
        assert_eq!(queue.len(), 1);
    }

    #[test]
    fn peer_request_queue_remove_returns_none_for_missing() {
        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));

        let removed = queue.remove(99, 0);
        assert!(removed.is_none());
        assert_eq!(queue.len(), 1); // queue unchanged
    }

    #[test]
    fn peer_request_queue_maintains_fifo() {
        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));
        queue.push(make_request(1, 0));
        queue.push(make_request(2, 0));

        let reqs: Vec<_> = queue.iter().map(|r| r.request.piece_index).collect();
        assert_eq!(reqs, vec![0, 1, 2]); // FIFO order
    }

    #[test]
    fn peer_request_queue_default_size() {
        let queue = PeerRequestQueue::with_default_size();
        assert!(!queue.is_full()); // not full when empty
        assert_eq!(queue.len(), 0);
        assert!(queue.is_empty());
    }

    #[test]
    fn peer_request_queue_default_constant_is_16() {
        assert_eq!(DEFAULT_MAX_REQUESTS_PER_PEER, 16);
    }

    #[test]
    fn peer_request_queue_drain_clears_and_returns_all() {
        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));
        queue.push(make_request(1, 0));
        queue.push(make_request(2, 0));

        let drained: Vec<_> = queue.drain().collect();
        assert_eq!(drained.len(), 3);
        assert!(queue.is_empty());
    }

    #[test]
    fn peer_request_queue_remove_makes_room_for_new_request() {
        let mut queue = PeerRequestQueue::new(2);
        queue.push(make_request(0, 0));
        queue.push(make_request(0, 16384));
        assert!(queue.is_full());

        // Remove one
        queue.remove(0, 0);
        assert!(!queue.is_full());

        // Now we can push again
        assert!(queue.push(make_request(1, 0)));
        assert!(queue.is_full());
    }

    #[test]
    fn timestamped_request_records_time() {
        let mut queue = PeerRequestQueue::new(10);
        let before = std::time::Instant::now();
        queue.push(make_request(0, 0));
        let after = std::time::Instant::now();

        let req = queue.iter().next().unwrap();
        assert!(req.sent_at >= before);
        assert!(req.sent_at <= after);
    }

    #[test]
    fn peer_request_queue_timed_out_returns_old_requests() {
        use std::time::Duration;

        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));

        // With 0 duration timeout, everything is timed out
        let timed_out = queue.timed_out(Duration::from_secs(0));
        assert_eq!(timed_out.len(), 1);

        // With very long timeout, nothing is timed out
        let timed_out = queue.timed_out(Duration::from_secs(3600));
        assert_eq!(timed_out.len(), 0);
    }

    #[test]
    fn request_timeout_constant_is_30_seconds() {
        assert_eq!(REQUEST_TIMEOUT_SECS, 30);
    }

    #[test]
    fn check_timeouts_returns_empty_for_fresh_requests() {
        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));

        // Immediately after push, nothing should be timed out
        // (30 seconds haven't passed)
        let timed_out = queue.check_timeouts();
        assert!(timed_out.is_empty());
    }

    #[test]
    fn check_timeouts_with_zero_duration_returns_all() {
        use std::time::Duration;

        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));

        // With zero duration, everything is timed out
        let timed_out = queue.check_timeouts_with(Duration::ZERO);
        assert!(!timed_out.is_empty());
        assert_eq!(timed_out.len(), 1);
    }

    #[test]
    fn check_timeouts_leaves_requests_in_queue() {
        use std::time::Duration;

        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));

        // Check timeouts (returns the timed-out requests)
        let timed_out = queue.check_timeouts_with(Duration::ZERO);
        assert_eq!(timed_out.len(), 1);

        // Request should still be in queue (caller's responsibility to remove)
        assert_eq!(queue.len(), 1);
    }

    #[test]
    fn check_timeouts_with_custom_duration() {
        use std::time::Duration;

        let mut queue = PeerRequestQueue::new(10);
        queue.push(make_request(0, 0));
        queue.push(make_request(0, 16384));
        queue.push(make_request(1, 0));

        // With very long timeout, nothing is timed out
        let timed_out = queue.check_timeouts_with(Duration::from_secs(3600));
        assert!(timed_out.is_empty());

        // With zero timeout, all three are timed out
        let timed_out = queue.check_timeouts_with(Duration::ZERO);
        assert_eq!(timed_out.len(), 3);
    }
