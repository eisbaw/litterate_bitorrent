#[cfg(test)]
mod connection_manager_tests {
    use super::*;
    use tokio::net::TcpListener;

    /// Creates a TCP stream pair for testing.
    ///
    /// Returns (client_stream, server_stream, client_addr).
    /// The server_stream can be dropped if not needed.
    async fn create_test_stream() -> (TcpStream, TcpStream, SocketAddr) {
        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
        let addr = listener.local_addr().unwrap();

        let (client, server) = tokio::join!(
            TcpStream::connect(addr),
            listener.accept()
        );

        let client_stream = client.unwrap();
        let (server_stream, _) = server.unwrap();

        (client_stream, server_stream, addr)
    }

    /// Helper to register a test connection with a manager.
    async fn register_test_connection(
        manager: &mut PeerConnectionManager,
        peer_id: [u8; 20],
    ) -> SocketAddr {
        let (stream, _server, addr) = create_test_stream().await;
        let handshake = Handshake::new([0xBB; 20], peer_id);
        manager.register_connection(stream, addr, &handshake).unwrap();
        addr
    }

    #[test]
    fn manager_new_creates_empty_manager() {
        let manager = PeerConnectionManager::new(
            [0xAA; 20],
            [0xBB; 20],
            100,
            DEFAULT_MAX_CONNECTIONS,
        );

        assert_eq!(manager.active_count(), 0);
        assert_eq!(manager.available_count(), 0);
        assert_eq!(manager.max_connections(), DEFAULT_MAX_CONNECTIONS);
        assert_eq!(manager.peer_id(), &[0xAA; 20]);
        assert_eq!(manager.info_hash(), &[0xBB; 20]);
    }

