#[cfg(test)]
mod peer_disconnect_tests {
    use super::*;
    use tokio::net::TcpListener;
    use crate::messages::Handshake;
    use crate::pieces::BlockRequest;

    /// Helper to create a test TCP stream pair.
    async fn create_test_stream() -> (TcpStream, TcpStream, SocketAddr) {
        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
        let addr = listener.local_addr().unwrap();

        let (client, server) = tokio::join!(
            TcpStream::connect(addr),
            listener.accept()
        );

        let client_stream = client.unwrap();
        let (server_stream, _) = server.unwrap();

        (client_stream, server_stream, addr)
    }

    /// Helper to register a test peer connection.
    async fn register_test_peer(
        manager: &mut PeerConnectionManager,
        peer_id: [u8; 20],
        has_piece: Option<u32>,
        peer_choking: bool,
    ) -> SocketAddr {
        let (stream, _server, addr) = create_test_stream().await;
        let handshake = Handshake::new([0xBB; 20], peer_id);
        manager.register_connection(stream, addr, &handshake).unwrap();

        // Set up piece availability and choking state
        if let Some(conn) = manager.get_connection_mut(&addr) {
            if let Some(piece_idx) = has_piece {
                conn.state.set_piece(piece_idx);
            }
            conn.state.peer_choking = peer_choking;
        }

        addr
    }

    #[test]
    fn peer_request_queue_drain_returns_all_requests() {
        let mut queue = PeerRequestQueue::new(10);
        let peer_id = *b"-LB0001-test12345678";

        // Add some requests
        queue.push(BlockRequest::new(0, 0, 16384, peer_id));
        queue.push(BlockRequest::new(0, 16384, 16384, peer_id));
        queue.push(BlockRequest::new(1, 0, 16384, peer_id));

        assert_eq!(queue.len(), 3);

        // Drain all requests
        let drained: Vec<_> = queue.drain().collect();

        assert_eq!(drained.len(), 3);
        assert!(queue.is_empty());

        // Verify request contents
        assert_eq!(drained[0].request.piece_index, 0);
        assert_eq!(drained[0].request.offset, 0);
        assert_eq!(drained[1].request.piece_index, 0);
        assert_eq!(drained[1].request.offset, 16384);
        assert_eq!(drained[2].request.piece_index, 1);
        assert_eq!(drained[2].request.offset, 0);
    }

    #[test]
    fn peer_request_queue_drain_on_empty_returns_nothing() {
        let mut queue = PeerRequestQueue::new(10);

        let drained: Vec<_> = queue.drain().collect();

        assert!(drained.is_empty());
        assert!(queue.is_empty());
    }

    #[tokio::test]
    async fn connection_manager_connections_map_provides_read_access() {
        let mut manager = PeerConnectionManager::new(
            [0xAA; 20],
            [0xBB; 20],
            10,
            DEFAULT_MAX_CONNECTIONS,
        );

        let addr = register_test_peer(&mut manager, [0x01; 20], Some(0), false).await;

        // Use connections_map for read access
        let map = manager.connections_map();
        assert!(map.contains_key(&addr));
        assert_eq!(map.len(), 1);
    }

    #[tokio::test]
    async fn find_alternative_peer_excludes_disconnected_peer() {
        let mut manager = PeerConnectionManager::new(
            [0xAA; 20],
            [0xBB; 20],
            10,
            DEFAULT_MAX_CONNECTIONS,
        );

        // Create two peers with piece 0
        let addr1 = register_test_peer(&mut manager, [0x01; 20], Some(0), false).await;
        let addr2 = register_test_peer(&mut manager, [0x02; 20], Some(0), false).await;

