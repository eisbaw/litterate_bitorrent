\subsubsection{Progress Display}

Displaying download progress keeps the user informed about what is happening.
We show pieces completed, percentage, download speed, and estimated time remaining.
The progress is printed to stderr (via tracing at INFO level) every 2 seconds.

<<event loop>>=
use serde::Serialize;
use chrono::Utc;

/// A progress event emitted when JSON logging is enabled.
///
/// This struct represents a single progress update containing all metrics
/// useful for monitoring a download. When `--json-log` is enabled, these
/// events are serialized to JSON and written to stderr every 2 seconds.
///
/// # Example JSON Output
///
/// ```json
/// {
///   "timestamp": "2024-01-18T12:34:56Z",
///   "event_type": "progress",
///   "pieces_done": 42,
///   "pieces_total": 100,
///   "percentage": 42.0,
///   "download_speed_bps": 1048576,
///   "upload_speed_bps": 0,
///   "peer_count": 5
/// }
/// ```
#[derive(Debug, Clone, Serialize)]
pub struct ProgressEvent {
    /// ISO 8601 timestamp when this event was generated.
    pub timestamp: String,

    /// Type of event (always "progress" for progress events).
    pub event_type: String,

    /// Number of pieces that have been downloaded and verified.
    pub pieces_done: u32,

    /// Total number of pieces in the torrent.
    pub pieces_total: u32,

    /// Download progress as a percentage (0.0 to 100.0).
    pub percentage: f64,

    /// Current download speed in bytes per second.
    pub download_speed_bps: u64,

    /// Current upload speed in bytes per second (currently always 0).
    pub upload_speed_bps: u64,

    /// Number of currently connected peers.
    pub peer_count: usize,
}

impl ProgressEvent {
    /// Creates a new progress event with the given metrics.
    pub fn new(
        pieces_done: u32,
        pieces_total: u32,
        percentage: f64,
        download_speed_bps: u64,
        peer_count: usize,
    ) -> Self {
        Self {
            timestamp: Utc::now().to_rfc3339(),
            event_type: "progress".to_string(),
            pieces_done,
            pieces_total,
            percentage,
            download_speed_bps,
            upload_speed_bps: 0, // Not tracking upload yet
            peer_count,
        }
    }

    /// Serializes this event to a JSON string.
    ///
    /// Returns an error if serialization fails (which should never happen
    /// for this simple struct).
    pub fn to_json(&self) -> Result<String, serde_json::Error> {
        serde_json::to_string(self)
    }
}

/// Handles the progress display timer event.
///
/// Displays download progress including:
/// - Pieces completed out of total (e.g., "42/100 pieces")
/// - Percentage complete (e.g., "42.0%")
/// - Download speed in human-readable format (e.g., "1.5 MB/s")
/// - Estimated time remaining
///
/// When `json_log` is enabled in the context, emits JSON to stderr instead
/// of human-readable text. This allows monitoring tools to parse progress.
///
/// Speed is calculated from bytes downloaded since the last progress display,
/// which gives a more responsive speed indication than average speed.
fn handle_progress_display(ctx: &mut EventLoopContext<'_>) {
    let now = std::time::Instant::now();
    let current_bytes = ctx.piece_manager.bytes_verified();
    let total_bytes = ctx.piece_manager.total_length();
    let (verified, total) = ctx.piece_manager.progress();

    // Calculate instantaneous speed from delta since last update
    let elapsed_since_last = now.duration_since(*ctx.last_progress_time);
    let bytes_since_last = current_bytes.saturating_sub(*ctx.last_progress_bytes);

    let speed_bytes_per_sec = if elapsed_since_last.as_secs_f64() > 0.0 {
        bytes_since_last as f64 / elapsed_since_last.as_secs_f64()
    } else {
        0.0
    };

    // Update tracking state for next calculation
    *ctx.last_progress_bytes = current_bytes;
    *ctx.last_progress_time = now;

    // Calculate percentage
    let percent = if total > 0 {
        (verified as f64 / total as f64) * 100.0
    } else {
        100.0
    };

    // JSON logging mode: emit structured event to stderr
    if ctx.json_log {
        let peer_count = ctx.connection_manager.active_count();
        let event = ProgressEvent::new(
            verified as u32,
            total as u32,
            percent,
            speed_bytes_per_sec as u64,
            peer_count,
        );
        if let Ok(json) = event.to_json() {
            eprintln!("{}", json);
        }
        return;
    }

    // Human-readable output mode (default)
    // Estimate time remaining based on current speed
    let remaining_bytes = total_bytes.saturating_sub(current_bytes);
    let eta = if speed_bytes_per_sec > 0.0 {
        let eta_secs = remaining_bytes as f64 / speed_bytes_per_sec;
        format_duration(eta_secs)
    } else if remaining_bytes == 0 {
        "done".to_string()
    } else {
        "calculating...".to_string()
    };

    // Format speed
    let speed_str = format_speed(speed_bytes_per_sec);

    // Log the progress
    info!(
        "{}/{} pieces ({:.1}%) - {} - ETA: {}",
        verified,
        total,
        percent,
        speed_str,
        eta
    );
}

/// Formats a download speed in bytes per second as a human-readable string.
///
/// Uses appropriate units (B/s, KB/s, MB/s, GB/s) based on magnitude.
///
/// # Examples
///
/// ```
/// # use literate_bittorrent::client::format_speed;
/// assert_eq!(format_speed(500.0), "500 B/s");
/// assert_eq!(format_speed(1536.0), "1.5 KB/s");
/// assert_eq!(format_speed(1572864.0), "1.5 MB/s");
/// ```
pub fn format_speed(bytes_per_sec: f64) -> String {
    if bytes_per_sec >= 1_073_741_824.0 {
        format!("{:.2} GB/s", bytes_per_sec / 1_073_741_824.0)
    } else if bytes_per_sec >= 1_048_576.0 {
        format!("{:.1} MB/s", bytes_per_sec / 1_048_576.0)
    } else if bytes_per_sec >= 1024.0 {
        format!("{:.1} KB/s", bytes_per_sec / 1024.0)
    } else {
        format!("{:.0} B/s", bytes_per_sec)
    }
}

/// Formats a duration in seconds as a human-readable string.
///
/// For durations under an hour, shows minutes and seconds (e.g., "5m 30s").
/// For longer durations, shows hours, minutes, and seconds (e.g., "2h 15m 30s").
/// Very large durations are capped at showing days.
///
/// # Examples
///
/// ```
/// # use literate_bittorrent::client::format_duration;
/// assert_eq!(format_duration(90.0), "1m 30s");
/// assert_eq!(format_duration(3661.0), "1h 1m 1s");
/// assert_eq!(format_duration(30.4), "30s");
/// ```
pub fn format_duration(seconds: f64) -> String {
    if seconds < 0.0 || !seconds.is_finite() {
        return "unknown".to_string();
    }

    let total_secs = seconds.round() as u64;

    if total_secs < 60 {
        return format!("{}s", total_secs);
    }

    let days = total_secs / 86400;
    let hours = (total_secs % 86400) / 3600;
    let minutes = (total_secs % 3600) / 60;
    let secs = total_secs % 60;

    if days > 0 {
        format!("{}d {}h {}m", days, hours, minutes)
    } else if hours > 0 {
        format!("{}h {}m {}s", hours, minutes, secs)
    } else {
        format!("{}m {}s", minutes, secs)
    }
}
