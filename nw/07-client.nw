    /// Integration test: simulate disconnect with request reassignment.
    ///
    /// This test verifies that when a peer disconnects with pending requests,
    /// those requests are drained and can be reassigned to an alternative peer.
    #[tokio::test]
    async fn disconnect_with_pending_requests_allows_reassignment() {
        let mut manager = PeerConnectionManager::new(
            [0xAA; 20],
            [0xBB; 20],
            10,
            DEFAULT_MAX_CONNECTIONS,
        );
        let mut request_queues: HashMap<SocketAddr, PeerRequestQueue> = HashMap::new();

        // Create two peers with piece 0
        let peer1_addr = register_test_peer(&mut manager, [0x01; 20], Some(0), false).await;
        let peer2_addr = register_test_peer(&mut manager, [0x02; 20], Some(0), false).await;

        // Queue requests to peer1
        let peer_id = *b"-LB0001-test12345678";
        let mut queue1 = PeerRequestQueue::new(10);
        queue1.push(BlockRequest::new(0, 0, 16384, peer_id));
        queue1.push(BlockRequest::new(0, 16384, 16384, peer_id));
        request_queues.insert(peer1_addr, queue1);

        // Verify initial state
        assert_eq!(manager.active_count(), 2);
        assert!(request_queues.contains_key(&peer1_addr));
        assert_eq!(request_queues.get(&peer1_addr).unwrap().len(), 2);

        // Simulate disconnect: drain peer1's requests
        let pending_requests: Vec<BlockRequest> = request_queues
            .remove(&peer1_addr)
            .map(|mut queue| queue.drain().map(|tr| tr.request).collect())
            .unwrap_or_default();

        // Verify requests were drained
        assert_eq!(pending_requests.len(), 2);
        assert!(!request_queues.contains_key(&peer1_addr));

        // Remove peer1 from connection manager
        manager.remove_connection(&peer1_addr);
        assert_eq!(manager.active_count(), 1);

        // Find alternative peer for reassignment
        for request in pending_requests {
            let alt_addr = find_alternative_peer(
                request.piece_index,
                peer1_addr,
                manager.connections_map(),
            );

            // Peer2 should be available for reassignment
            assert!(alt_addr.is_some(), "Should find alternative peer");
            assert_eq!(alt_addr.unwrap(), peer2_addr);

            // Queue to alternative peer
            let alt_queue = request_queues.entry(alt_addr.unwrap()).or_insert_with(|| {
                PeerRequestQueue::new(10)
            });
            let new_request = BlockRequest::new(
                request.piece_index,
                request.offset,
                request.length,
                peer_id,
            );
            assert!(alt_queue.push(new_request));
        }

        // Verify peer2 now has the reassigned requests
        assert!(request_queues.contains_key(&peer2_addr));
        assert_eq!(request_queues.get(&peer2_addr).unwrap().len(), 2);

        // Verify peer2 connection is still active
        assert!(manager.get_connection(&peer2_addr).is_some());
    }

    /// Integration test: all peers disconnect leaves pool available for reconnection.
    ///
    /// When all peers disconnect, the available peer pool should still be
    /// accessible for the connection manager to use when re-announce provides
    /// fresh peers.
    #[tokio::test]
    async fn all_peers_disconnect_maintains_available_pool() {
        let mut manager = PeerConnectionManager::new(
            [0xAA; 20],
            [0xBB; 20],
            10,
            30, // Max connections
        );

        // Add some available peers to the pool
        manager.add_peers(vec![
            "192.168.1.1:6881".parse().unwrap(),
            "192.168.1.2:6881".parse().unwrap(),
        ]);
        assert_eq!(manager.available_count(), 2);

        // Connect one peer
        let addr = register_test_peer(&mut manager, [0x01; 20], None, false).await;
        assert_eq!(manager.active_count(), 1);

        // Disconnect the peer
        manager.remove_connection(&addr);
        assert_eq!(manager.active_count(), 0);

        // Available pool should still have peers
        assert_eq!(manager.available_count(), 2);

        // Manager should signal it needs more connections
        assert!(manager.needs_more_connections());

        // Pop an available peer for reconnection
        let next_peer = manager.pop_available();
        assert!(next_peer.is_some());
        assert_eq!(manager.available_count(), 1);
    }
