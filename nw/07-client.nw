        assert_eq!(alt.unwrap(), addr2);

        // Find alternative excluding addr2 should return addr1
        let alt = find_alternative_peer(0, addr2, manager.connections_map());
        assert!(alt.is_some());
        assert_eq!(alt.unwrap(), addr1);
    }

