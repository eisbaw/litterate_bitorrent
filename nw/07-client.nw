    fn peer_state_has_piece_checks_bitfield() {
        // AC #6: has_piece checks bitfield
        let mut state = PeerState::new(100);

        // Initially no pieces
        assert!(!state.has_piece(0));
        assert!(!state.has_piece(42));
        assert!(!state.has_piece(99));

        // Set piece 0 (bit 7 of byte 0 in MSB-first order)
        state.bitfield[0] = 0b1000_0000;
        assert!(state.has_piece(0));
        assert!(!state.has_piece(1));

        // Set piece 7 (bit 0 of byte 0)
        state.bitfield[0] = 0b0000_0001;
        assert!(state.has_piece(7));
        assert!(!state.has_piece(0));

        // Set piece 8 (bit 7 of byte 1)
        state.bitfield[1] = 0b1000_0000;
        assert!(state.has_piece(8));
        assert!(!state.has_piece(9));
    }

