    #[tokio::test]
    async fn connect_with_timeout_returns_error_for_refused() {
        // Try to connect to a port that's not listening.
        // Port 1 is a privileged port (tcpmux) that is almost never open.
        let addr: SocketAddr = "127.0.0.1:1".parse().unwrap();
        let result = connect_with_timeout(addr).await;

        // Should fail with an I/O error (connection refused or similar)
        assert!(matches!(result, Err(PeerError::IoError(_))));
    }

    #[test]
    fn connect_with_timeout_uses_correct_timeout() {
        // Verify the constant is set correctly as specified in the PRD
        assert_eq!(CONNECT_TIMEOUT_SECS, 10);
    }
