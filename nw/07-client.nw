//! Client orchestration for BitTorrent downloads.
//!
//! The [`Client`] struct is the central point for managing a torrent download.
//! It owns all state: metadata, piece tracking, peer connections, and
//! configuration. This module also provides peer ID generation and graceful
//! shutdown handling.
//!
//! # Graceful Shutdown
//!
//! The [`ShutdownController`] and [`install_signal_handler`] function provide
//! coordinated shutdown when the user presses Ctrl+C. The first press initiates
//! graceful shutdown (tracker notification, peer disconnection, disk flush),
//! while a second press forces immediate exit with code 130.
//!
//! # Example
//!
//! ```no_run
//! use std::path::PathBuf;
//! use std::sync::Arc;
//! use literate_bittorrent::client::{Client, ShutdownController, install_signal_handler};
//! use literate_bittorrent::metainfo;
//!
//! #[tokio::main]
//! async fn main() {
//!     // Set up shutdown handling
//!     let shutdown = Arc::new(ShutdownController::new());
//!     install_signal_handler(shutdown.clone());
//!
//!     let data = std::fs::read("example.torrent").unwrap();
//!     let metainfo = metainfo::parse(&data).unwrap();
//!
//!     let client = Client::new(
