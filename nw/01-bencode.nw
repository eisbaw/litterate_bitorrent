    #[test]
    fn decode_dict_byte_ordering() {
        // AC #6: Handles keys with different sorting than ASCII order
        // Keys with raw bytes that sort differently than ASCII strings might
        // BTreeMap uses lexicographic byte comparison, which is what bencode requires
        // Input keys out of order, but BTreeMap will sort them
        let input = b"d1:b1:21:a1:1e";
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);

        let mut expected = std::collections::BTreeMap::new();
        expected.insert(b"a".to_vec(), BencodeValue::Bytes(b"1".to_vec()));
        expected.insert(b"b".to_vec(), BencodeValue::Bytes(b"2".to_vec()));

        assert_eq!(result, Ok(BencodeValue::Dict(expected)));

        // Verify iteration order is sorted (a before b)
        if let Ok(BencodeValue::Dict(map)) = result {
            let keys: Vec<_> = map.keys().collect();
            assert_eq!(keys, vec![&b"a".to_vec(), &b"b".to_vec()]);
        }
    }

    #[test]
    fn decode_dict_binary_keys() {
        // Keys with non-ASCII bytes (raw binary)
        // These sort by raw byte value, not UTF-8 interpretation
        let input: &[u8] = &[
            b'd',
            b'1', b':', 0xFF, // key: [0xFF]
            b'1', b':', b'1', // value: "1"
            b'1', b':', 0x00, // key: [0x00]
            b'1', b':', b'2', // value: "2"
            b'e',
        ];
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);

        // BTreeMap will sort: 0x00 < 0xFF
        if let Ok(BencodeValue::Dict(map)) = &result {
            let keys: Vec<_> = map.keys().collect();
            assert_eq!(keys[0], &vec![0x00u8]);
            assert_eq!(keys[1], &vec![0xFFu8]);
        } else {
            panic!("Expected Dict, got {:?}", result);
        }
    }

