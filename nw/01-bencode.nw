    #[test]
    fn reject_malformed_key() {
        // Key with invalid length prefix
        let input = b"d03:key5:valuee";
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);
        // Leading zero in length should fail
        assert!(matches!(result, Err(BencodeError::InvalidLength(_))));
    }

    #[test]
    fn reject_missing_d_prefix() {
        // Input doesn't start with 'd'
        let input = b"3:key5:valuee";
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);
        assert!(matches!(result, Err(BencodeError::InvalidFormat(_))));
    }

    #[test]
    fn decode_dict_at_nonzero_position() {
        // Test parsing when pos doesn't start at 0
        let input = b"XXXd1:a1:bee";
        let mut pos = 3;
        let result = decode_dict(input, &mut pos);

        let mut expected = std::collections::BTreeMap::new();
        expected.insert(b"a".to_vec(), BencodeValue::Bytes(b"b".to_vec()));

        assert_eq!(result, Ok(BencodeValue::Dict(expected)));
        assert_eq!(pos, 11);
    }

    #[test]
    fn reject_dict_empty_input() {
        let input = b"";
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);
        assert!(matches!(result, Err(BencodeError::UnexpectedEof)));
    }

    #[test]
    fn reject_dict_position_past_end() {
        let input = b"de";
        let mut pos = 10;
        let result = decode_dict(input, &mut pos);
        assert!(matches!(result, Err(BencodeError::UnexpectedEof)));
    }

    #[test]
    fn decode_dict_list_in_value() {
        // Dict containing a list value
        // d5:itemsli1ei2ei3eee -> {"items": [1, 2, 3]}
        let input = b"d5:itemsli1ei2ei3eee";
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);

        let mut expected = std::collections::BTreeMap::new();
        expected.insert(
            b"items".to_vec(),
            BencodeValue::List(vec![
                BencodeValue::Integer(1),
                BencodeValue::Integer(2),
                BencodeValue::Integer(3),
            ]),
        );

        assert_eq!(result, Ok(BencodeValue::Dict(expected)));
    }

    #[test]
    fn decode_torrent_like_dict() {
        // A dict structure similar to a torrent file's info dict
        // d6:lengthi1024e4:name8:test.txt12:piece lengthi16384ee
        let input = b"d6:lengthi1024e4:name8:test.txt12:piece lengthi16384ee";
        let mut pos = 0;
        let result = decode_dict(input, &mut pos);

        let mut expected = std::collections::BTreeMap::new();
        expected.insert(b"length".to_vec(), BencodeValue::Integer(1024));
        expected.insert(b"name".to_vec(), BencodeValue::Bytes(b"test.txt".to_vec()));
        expected.insert(b"piece length".to_vec(), BencodeValue::Integer(16384));

        assert_eq!(result, Ok(BencodeValue::Dict(expected)));
    }
}
