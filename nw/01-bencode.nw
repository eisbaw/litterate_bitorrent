        assert_eq!(result, Ok(BencodeValue::Dict(expected)));

        // Verify iteration order is sorted (a before b)
        if let Ok(BencodeValue::Dict(map)) = result {
            let keys: Vec<_> = map.keys().collect();
            assert_eq!(keys, vec![&b"a".to_vec(), &b"b".to_vec()]);
