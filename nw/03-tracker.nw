\subsection{Error Handling Tests}

We test that our error types work correctly with the standard error traits
and provide useful error messages.

<<tracker error tests>>=
#[test]
fn tracker_error_response_displays_reason() {
    let err = TrackerError::TrackerErrorResponse("torrent not registered".to_string());
    let msg = err.to_string();
    assert!(msg.contains("torrent not registered"), "msg: {}", msg);
    assert!(msg.contains("tracker returned error"), "msg: {}", msg);
}

#[test]
fn tracker_invalid_response_displays_details() {
    let err = TrackerError::TrackerInvalidResponse("missing 'peers' field".to_string());
    let msg = err.to_string();
    assert!(msg.contains("missing 'peers' field"), "msg: {}", msg);
    assert!(msg.contains("invalid tracker response"), "msg: {}", msg);
}

#[test]
fn tracker_timeout_has_clear_message() {
    let err = TrackerError::TrackerTimeout;
    let msg = err.to_string();
    assert!(msg.contains("30 seconds"), "msg: {}", msg);
    assert!(msg.contains("timed out"), "msg: {}", msg);
}

#[test]
fn tracker_error_implements_std_error() {
    // Verify TrackerError implements std::error::Error
    fn assert_error<E: std::error::Error>() {}
    assert_error::<TrackerError>();
}

#[test]
fn tracker_error_implements_debug() {
    // Verify TrackerError implements Debug
    let err = TrackerError::TrackerTimeout;
    let debug = format!("{:?}", err);
    assert!(!debug.is_empty());
}
@

These tests verify that:
\begin{enumerate}
\item Error messages include the relevant context (failure reasons, field names).
\item The timeout error clearly states the 30-second timeout period.
\item [[TrackerError]] implements [[std::error::Error]] as required.
\item [[TrackerError]] implements [[Debug]] for diagnostic purposes.
\end{enumerate}
