}

#[test]
fn parse_compact_peers_not_divisible_by_6_returns_error() {
    // 7 bytes is not divisible by 6
    let data: [u8; 7] = [0xC0, 0xA8, 0x01, 0x01, 0x1A, 0xE1, 0xFF];

    let result = parse_compact_peers(&data);
    assert!(result.is_err(), "7 bytes should be rejected");

    match result {
        Err(TrackerError::TrackerInvalidResponse(msg)) => {
            assert!(
                msg.contains("not divisible by 6"),
                "Error should mention divisibility: {}",
                msg
            );
            assert!(msg.contains("7"), "Error should mention actual length: {}", msg);
        }
        other => panic!("Expected TrackerInvalidResponse, got {:?}", other),
    }
}

#[test]
fn parse_compact_peers_endianness_verification() {
    // Test with a known value where endianness matters
    // IP: 1.2.3.4 (should be bytes 0x01, 0x02, 0x03, 0x04 in that order)
    // Port: 258 (0x0102) should be bytes 0x01, 0x02 (big-endian)
    let data: [u8; 6] = [0x01, 0x02, 0x03, 0x04, 0x01, 0x02];

    let result = parse_compact_peers(&data);
    assert!(result.is_ok());

    let peers = result.unwrap();
    assert_eq!(peers.len(), 1);

    // Verify the IP address octets are in correct order
    assert_eq!(peers[0].to_string(), "1.2.3.4:258");

    // Also verify by extracting the SocketAddrV4
    if let SocketAddr::V4(addr) = peers[0] {
        assert_eq!(addr.ip().octets(), [1, 2, 3, 4]);
        assert_eq!(addr.port(), 258);
    } else {
        panic!("Expected IPv4 address");
    }
}

