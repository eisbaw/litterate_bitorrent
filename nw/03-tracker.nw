fn build_announce_url_encodes_info_hash_correctly() {
    // Use a known hash with specific bytes to verify encoding
    let request = TrackerRequest {
        info_hash: [
            0x00, 0x01, 0x02, 0x20, 0x3F, // Bytes that need encoding
            b'A', b'Z', b'a', b'z', b'0', // Unreserved chars
            b'9', b'-', b'_', b'.', b'~', // More unreserved
            0xFF, 0xFE, 0x80, 0x7F, 0x2F, // More bytes to encode
        ],
        peer_id: [0u8; 20],
        port: 6881,
        uploaded: 0,
        downloaded: 0,
        left: 0,
        event: None,
        compact: true,
