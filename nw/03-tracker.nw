    let url = build_announce_url("http://tracker.example.com/announce", &request);

    // Extract the info_hash parameter value
    let info_hash_start = url.find("info_hash=").unwrap() + 10;
    let info_hash_end = url[info_hash_start..].find('&').unwrap() + info_hash_start;
    let info_hash_encoded = &url[info_hash_start..info_hash_end];

    // Verify encoding of specific bytes
    assert!(info_hash_encoded.contains("%00")); // null byte
    assert!(info_hash_encoded.contains("%20")); // space
    assert!(info_hash_encoded.contains("%3F")); // '?'
    assert!(info_hash_encoded.contains("A"));   // unreserved
    assert!(info_hash_encoded.contains("z"));   // unreserved
    assert!(info_hash_encoded.contains("%FF")); // high byte
    assert!(info_hash_encoded.contains("%2F")); // '/'
}

