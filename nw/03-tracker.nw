#[test]
fn parse_compact_peers_two_peers() {
    // Two peers: 192.168.1.1:6881 and 10.0.0.1:8080
    // 192.168.1.1 = 0xC0, 0xA8, 0x01, 0x01
    // 6881 = 0x1AE1 -> 0x1A, 0xE1
    // 10.0.0.1 = 0x0A, 0x00, 0x00, 0x01
    // 8080 = 0x1F90 -> 0x1F, 0x90
    let data: [u8; 12] = [
        0xC0, 0xA8, 0x01, 0x01, 0x1A, 0xE1,  // 192.168.1.1:6881
        0x0A, 0x00, 0x00, 0x01, 0x1F, 0x90,  // 10.0.0.1:8080
    ];

    let result = parse_compact_peers(&data);
    assert!(result.is_ok(), "Should parse valid peer data: {:?}", result);

    let peers = result.unwrap();
    assert_eq!(peers.len(), 2);
    assert_eq!(peers[0].to_string(), "192.168.1.1:6881");
    assert_eq!(peers[1].to_string(), "10.0.0.1:8080");
}

