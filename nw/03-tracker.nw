#[test]
fn parse_valid_compact_response() {
    // Minimal valid response with compact peers
    // d8:intervali1800e5:peers6:......e
    // The peer data is 6 bytes representing one peer
    let peer_data = vec![192, 168, 1, 1, 0x1A, 0xE1]; // 192.168.1.1:6881
    let mut response = b"d8:intervali1800e5:peers6:".to_vec();
    response.extend_from_slice(&peer_data);
    response.push(b'e');

    let result = parse_tracker_response(&response);
    assert!(result.is_ok(), "Should parse valid response: {:?}", result);

    let parsed = result.unwrap();
    assert_eq!(parsed.interval, 1800);
    assert_eq!(parsed.peers, peer_data);
    assert_eq!(parsed.min_interval, None);
    assert_eq!(parsed.complete, None);
    assert_eq!(parsed.incomplete, None);
}

