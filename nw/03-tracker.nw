#[test]
fn announce_function_exists_with_correct_signature() {
    // This test verifies that the announce function has the expected signature.
    // We verify the return type is correct by checking a reference to it.
    // The actual function requires async runtime and network access, so we
    // don't call it here.
    use std::path::PathBuf;

    // Create a dummy metainfo for type checking only
    let metainfo = crate::metainfo::Metainfo {
        announce: "http://example.com/announce".to_string(),
        info_hash: [0u8; 20],
        piece_length: 262144,
        piece_hashes: vec![[0u8; 20]],
        total_length: 1000,
        files: vec![crate::metainfo::FileInfo {
            length: 1000,
            path: PathBuf::from("test.txt"),
