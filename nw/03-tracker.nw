#[test]
fn parse_compact_peers_many_peers() {
    // Test with 10 peers to verify batch processing
    let mut data = Vec::with_capacity(60);
    for i in 0..10 {
        // Create peers: 192.168.1.i:6881+i
        data.push(192);
        data.push(168);
        data.push(1);
        data.push(i);
        let port: u16 = 6881 + i as u16;
        data.push((port >> 8) as u8);
        data.push((port & 0xFF) as u8);
