#[test]
fn announce_result_construction() {
    use std::net::{Ipv4Addr, SocketAddrV4};

    let peers = vec![
        SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::new(192, 168, 1, 1), 6881)),
        SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::new(10, 0, 0, 1), 8080)),
    ];

    let result = AnnounceResult {
        peers: peers.clone(),
        interval: 1800,
        seeders: Some(10),
        leechers: Some(5),
    };

    assert_eq!(result.peers.len(), 2);
    assert_eq!(result.interval, 1800);
    assert_eq!(result.seeders, Some(10));
    assert_eq!(result.leechers, Some(5));
}

