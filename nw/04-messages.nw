fn to_bytes_round_trip() {
    // Test that serialization is deterministic and contains the correct data.
    // We parse the bytes back manually (since from_bytes is in a separate task)
    // to verify round-trip correctness.
    let info_hash = *b"AAAABBBBCCCCDDDDEEEE";
    let peer_id = *b"-LB0001-TESTPEERIDNN";

    let hs = Handshake::new(info_hash, peer_id);
    let bytes = hs.to_bytes();

    // Extract fields from serialized bytes
    let extracted_pstrlen = bytes[0];
    let extracted_pstr = &bytes[1..20];
    let extracted_reserved = &bytes[20..28];
    let extracted_info_hash: [u8; 20] = bytes[28..48].try_into().unwrap();
    let extracted_peer_id: [u8; 20] = bytes[48..68].try_into().unwrap();

    // Verify fixed fields
    assert_eq!(extracted_pstrlen, 19);
    assert_eq!(extracted_pstr, PROTOCOL_STRING);
    assert_eq!(extracted_reserved, &[0u8; 8]);

    // Verify variable fields match original
    assert_eq!(extracted_info_hash, info_hash);
    assert_eq!(extracted_peer_id, peer_id);

    // Create a new handshake from extracted fields and verify equality
    let reconstructed = Handshake::new(extracted_info_hash, extracted_peer_id);
    assert_eq!(hs, reconstructed);
}

