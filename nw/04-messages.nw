#[test]
fn message_to_bytes_length_prefix_is_correct() {
    // Verify the length prefix matches the actual payload length
    // for each message type

    let test_cases: Vec<(Message, u32)> = vec![
        (Message::KeepAlive, 0),
        (Message::Choke, 1),
        (Message::Unchoke, 1),
        (Message::Interested, 1),
        (Message::NotInterested, 1),
        (Message::Have(0), 5),
        (Message::Bitfield(vec![]), 1),
        (Message::Bitfield(vec![0; 10]), 11),
        (Message::Request { index: 0, begin: 0, length: 0 }, 13),
        (Message::Piece { index: 0, begin: 0, data: vec![] }, 9),
        (Message::Piece { index: 0, begin: 0, data: vec![0; 100] }, 109),
        (Message::Cancel { index: 0, begin: 0, length: 0 }, 13),
    ];

    for (msg, expected_length) in test_cases {
        let bytes = msg.to_bytes();

        // Extract length from first 4 bytes (big-endian)
        let actual_length = u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]);
        assert_eq!(
            actual_length, expected_length,
            "Wrong length prefix for {:?}: expected {}, got {}",
            msg, expected_length, actual_length
        );

        // Verify total message length = 4 + payload length
        assert_eq!(
            bytes.len(),
            4 + expected_length as usize,
            "Wrong total length for {:?}",
            msg
        );
    }
}
