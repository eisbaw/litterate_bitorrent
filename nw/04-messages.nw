    assert!(msg.contains("length") || msg.contains("mismatch"));
}

#[test]
fn from_bytes_rejects_extra_bytes() {
    // Length says 1 byte follows (choke), but we have 2
    let bytes = vec![0, 0, 0, 1, 0, 0xFF]; // extra byte
