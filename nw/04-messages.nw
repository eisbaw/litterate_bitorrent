\subsection{Error Display Tests}

We verify that each error variant produces a human-readable message containing
the relevant information. These tests document the expected error message format.

<<peer error display tests>>=
#[test]
fn handshake_failed_displays_reason() {
    let err = PeerError::HandshakeFailed("wrong info hash".to_string());
    let msg = err.to_string();
    assert!(msg.contains("handshake failed"), "msg: {}", msg);
    assert!(msg.contains("wrong info hash"), "msg: {}", msg);
}

#[test]
fn invalid_message_displays_details() {
    let err = PeerError::InvalidMessage("request payload too short".to_string());
    let msg = err.to_string();
    assert!(msg.contains("invalid message"), "msg: {}", msg);
    assert!(msg.contains("request payload too short"), "msg: {}", msg);
}

#[test]
fn unexpected_message_id_displays_id() {
    let err = PeerError::UnexpectedMessageId(99);
    let msg = err.to_string();
    assert!(msg.contains("99"), "msg: {}", msg);
    assert!(msg.contains("unexpected message ID") || msg.contains("message ID"), "msg: {}", msg);
}

#[test]
fn message_too_large_displays_size() {
    let err = PeerError::MessageTooLarge(1_048_576);
    let msg = err.to_string();
    assert!(msg.contains("1048576"), "msg: {}", msg);
    assert!(msg.contains("too large"), "msg: {}", msg);
}

#[test]
fn bitfield_wrong_length_displays_both_lengths() {
    let err = PeerError::BitfieldWrongLength {
        expected: 100,
        actual: 50,
    };
    let msg = err.to_string();
    assert!(msg.contains("100"), "msg: {}", msg);
    assert!(msg.contains("50"), "msg: {}", msg);
    assert!(msg.contains("bitfield") || msg.contains("wrong length"), "msg: {}", msg);
}

#[test]
fn timeout_has_clear_message() {
    let err = PeerError::Timeout;
    let msg = err.to_string();
    assert!(msg.contains("timed out") || msg.contains("timeout"), "msg: {}", msg);
}

#[test]
fn connection_closed_has_clear_message() {
    let err = PeerError::ConnectionClosed;
    let msg = err.to_string();
    assert!(msg.contains("connection") || msg.contains("closed"), "msg: {}", msg);
}

#[test]
fn io_error_wraps_underlying_error() {
    let io_err = io::Error::new(io::ErrorKind::ConnectionRefused, "connection refused");
    let err = PeerError::IoError(io_err);
    let msg = err.to_string();
    assert!(msg.contains("I/O error") || msg.contains("connection refused"), "msg: {}", msg);
}
@

\subsection{Error Trait Tests}

We verify that [[PeerError]] implements the required traits correctly.

<<peer error trait tests>>=
#[test]
fn peer_error_implements_std_error() {
    fn assert_error<E: std::error::Error>() {}
    assert_error::<PeerError>();
}

#[test]
fn peer_error_implements_debug() {
    let err = PeerError::Timeout;
    let debug = format!("{:?}", err);
    assert!(!debug.is_empty());
}

#[test]
fn peer_error_implements_send_sync() {
    fn assert_send_sync<T: Send + Sync>() {}
    // Note: PeerError contains io::Error which is Send + Sync
    // but we should verify our enum is too
    assert_send_sync::<PeerError>();
}

#[test]
fn io_error_conversion_works() {
    fn produces_io_error() -> Result<(), PeerError> {
        let io_err = io::Error::new(io::ErrorKind::NotFound, "file not found");
        Err(io_err)?
    }

    let result = produces_io_error();
    assert!(matches!(result, Err(PeerError::IoError(_))));
}
@

The [[io_error_conversion_works]] test verifies that the [[#[from]]] attribute
works correctly, allowing [[?]] to automatically convert [[std::io::Error]]
into [[PeerError::IoError]]. This is important for ergonomic error handling
in async code where I/O operations are frequent.

\subsection{Next Steps}

With error types defined, the messages module is ready for:
\begin{enumerate}
\item Handshake struct and parsing
\item Message enum with serialization/deserialization
\item Length-prefix framing helpers
\end{enumerate}

These will be added in subsequent development as we build out the peer
protocol implementation.
