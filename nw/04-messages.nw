        "pstr should be 'BitTorrent protocol'"
    );

    // Bytes 20-27: reserved (zeros)
    assert_eq!(
        &bytes[20..28],
        &[0u8; 8],
        "reserved bytes should be zeros"
    );

    // Bytes 28-47: info_hash
    assert_eq!(
        &bytes[28..48],
        &info_hash,
        "info_hash should match input"
