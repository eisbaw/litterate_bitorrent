        Message::Request { index: 0, begin: 0, length: 16384 },
        Message::Request { index: 999, begin: 32768, length: 8192 },
        Message::Piece { index: 0, begin: 0, data: vec![] },
        Message::Piece { index: 42, begin: 16384, data: vec![1, 2, 3, 4, 5] },
        Message::Cancel { index: 0, begin: 0, length: 16384 },
    ];

    for original in messages {
        let bytes = original.to_bytes();
        let parsed = Message::from_bytes(&bytes)
            .unwrap_or_else(|e| panic!("failed to parse {:?}: {}", original, e));
        assert_eq!(parsed, original, "round-trip failed for {:?}", original);
    }
