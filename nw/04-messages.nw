    let peer_id: [u8; 20] = [
        0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8, 0xA9, 0xAA,
        0xAB, 0xAC, 0xAD, 0xAE, 0xAF, 0xB0, 0xB1, 0xB2, 0xB3, 0xB4,
    ];
    let hs = Handshake::new(info_hash, peer_id);
    let bytes = hs.to_bytes();

    // Byte 0: pstrlen = 19
    assert_eq!(bytes[0], 19, "pstrlen should be 19");

