// ===== Edge cases =====

#[test]
fn from_bytes_piece_exactly_8_bytes_payload() {
    // Minimum valid piece: index + begin, no data
    let bytes = vec![0, 0, 0, 9, 7, 0, 0, 0, 1, 0, 0, 0, 2];
    let msg = Message::from_bytes(&bytes).expect("valid minimal piece");
    assert_eq!(msg, Message::Piece { index: 1, begin: 2, data: vec![] });
}

#[test]
fn from_bytes_large_bitfield() {
    // 1000 pieces = 125 bytes bitfield
    let bitfield_data: Vec<u8> = (0..125).map(|i| (i * 17) as u8).collect();
    let length = 1 + bitfield_data.len() as u32;
    let mut bytes = length.to_be_bytes().to_vec();
    bytes.push(5); // MSG_BITFIELD
    bytes.extend_from_slice(&bitfield_data);

    let msg = Message::from_bytes(&bytes).expect("valid large bitfield");
    assert_eq!(msg, Message::Bitfield(bitfield_data));
}

#[test]
fn from_bytes_max_piece_index() {
    let bytes = vec![0, 0, 0, 5, 4, 0xFF, 0xFF, 0xFF, 0xFF];
    let msg = Message::from_bytes(&bytes).expect("valid have with max index");
    assert_eq!(msg, Message::Have(u32::MAX));
}
@

These parsing tests verify:
\begin{itemize}
\item All valid message types parse correctly
\item Round-trip serialization/deserialization preserves message content
\item Empty input is rejected
\item Truncated messages are rejected
\item Extra bytes cause rejection
\item Unknown message IDs return [[UnexpectedMessageId]]
\item Have requires exactly 4 bytes payload
\item Request/Cancel require exactly 12 bytes payload
\item Piece requires at least 8 bytes payload (index + begin)
\item Messages without payloads reject extra data
\item Edge cases like maximum values work correctly
\end{itemize}

\subsection{Next Steps}

With message serialization and parsing complete, the messages module is ready for:
\begin{enumerate}
\item Async I/O wrappers for framed message exchange
\item Integration with the peer connection handler
\end{enumerate}

These will be added in subsequent development as we build out the peer
protocol implementation.
