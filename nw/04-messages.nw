        Message::NotInterested,
        Message::Have(42),
        Message::Bitfield(vec![0xFF, 0x00]),
        Message::Request { index: 1, begin: 0, length: BLOCK_SIZE },
        Message::Piece { index: 1, begin: 0, data: vec![1, 2, 3] },
