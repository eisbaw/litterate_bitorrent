\subsection{Tests}

We test file creation thoroughly, verifying both successful cases and error
handling. The tests use Rust's [[tempfile]] crate to create temporary directories
that are automatically cleaned up.

<<disk tests>>=
#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::tempdir;

    #[test]
    fn create_single_file() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        let files = vec![FileInfo {
            length: 1024,
            path: PathBuf::from("test.txt"),
        }];

        create_output_files(output_dir, &files).expect("create files");

        let created = output_dir.join("test.txt");
        assert!(created.exists(), "file should exist");

        let metadata = fs::metadata(&created).expect("get metadata");
        assert_eq!(metadata.len(), 1024, "file should have correct size");
    }

    #[test]
    fn create_file_with_parent_directories() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        let files = vec![FileInfo {
            length: 2048,
            path: PathBuf::from("deep/nested/path/file.bin"),
        }];

        create_output_files(output_dir, &files).expect("create files");

        let created = output_dir.join("deep/nested/path/file.bin");
        assert!(created.exists(), "file should exist");
        assert!(output_dir.join("deep/nested/path").is_dir(), "directories should exist");

        let metadata = fs::metadata(&created).expect("get metadata");
        assert_eq!(metadata.len(), 2048);
    }

    #[test]
    fn create_multiple_files() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        let files = vec![
            FileInfo {
                length: 100,
                path: PathBuf::from("torrent_name/file1.txt"),
            },
            FileInfo {
                length: 200,
                path: PathBuf::from("torrent_name/file2.txt"),
            },
            FileInfo {
                length: 300,
                path: PathBuf::from("torrent_name/subdir/file3.txt"),
            },
        ];

        create_output_files(output_dir, &files).expect("create files");

        // Verify all files exist with correct sizes
        for file_info in &files {
            let path = output_dir.join(&file_info.path);
            assert!(path.exists(), "file {:?} should exist", file_info.path);

            let metadata = fs::metadata(&path).expect("get metadata");
            assert_eq!(
                metadata.len(),
                file_info.length,
                "file {:?} should have correct size",
                file_info.path
            );
        }
    }

    #[test]
    fn idempotent_does_not_modify_existing_files() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        let files = vec![FileInfo {
            length: 1000,
            path: PathBuf::from("existing.txt"),
        }];

        // Create files first time
        create_output_files(output_dir, &files).expect("first create");

        // Write some data to the file
        let file_path = output_dir.join("existing.txt");
        fs::write(&file_path, b"test data").expect("write data");

        // Get modification time
        let mtime_before = fs::metadata(&file_path)
            .expect("metadata")
            .modified()
            .expect("mtime");

        // Small delay to ensure filesystem timestamp granularity
        std::thread::sleep(std::time::Duration::from_millis(10));

        // Call create_output_files again
        create_output_files(output_dir, &files).expect("second create");

        // File should still exist with the same modification time
        let mtime_after = fs::metadata(&file_path)
            .expect("metadata")
            .modified()
            .expect("mtime");

        assert_eq!(
            mtime_before, mtime_after,
            "file should not be modified on second call"
        );

        // Content should be preserved
        let content = fs::read(&file_path).expect("read content");
        assert_eq!(content, b"test data", "content should be preserved");
    }

    #[test]
    fn create_zero_length_file() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        let files = vec![FileInfo {
            length: 0,
            path: PathBuf::from("empty.txt"),
        }];

        create_output_files(output_dir, &files).expect("create files");

        let created = output_dir.join("empty.txt");
        assert!(created.exists(), "empty file should exist");

        let metadata = fs::metadata(&created).expect("get metadata");
        assert_eq!(metadata.len(), 0, "empty file should have size 0");
    }

    #[test]
    fn sparse_file_does_not_allocate_disk_space() {
        // This test verifies sparse file behavior by creating a large file
        // and checking that disk usage is minimal

        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        // Create a 1 GB sparse file
        let large_size: u64 = 1024 * 1024 * 1024;
        let files = vec![FileInfo {
            length: large_size,
            path: PathBuf::from("sparse_large.bin"),
        }];

        create_output_files(output_dir, &files).expect("create sparse file");

        let created = output_dir.join("sparse_large.bin");
        let metadata = fs::metadata(&created).expect("get metadata");

        // File should report full size
        assert_eq!(metadata.len(), large_size, "file should report 1 GB size");

        // Note: We can't reliably test actual disk usage across all platforms,
        // but on Linux we could check blocks * 512 < len. For this test,
        // we just verify the file was created and has the correct reported size.
        // The sparse behavior is filesystem-dependent but works on ext4, Btrfs,
        // NTFS, APFS, etc.
    }

    #[test]
    fn handles_existing_file_with_different_size() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        // Create a file with different size manually
        let file_path = output_dir.join("existing.txt");
        fs::create_dir_all(output_dir).expect("create dir");
        fs::write(&file_path, b"existing content with different length").expect("write");

        let files = vec![FileInfo {
            length: 1000, // Different from actual file size
            path: PathBuf::from("existing.txt"),
        }];

        // Should succeed without truncating
        create_output_files(output_dir, &files).expect("create files");

        // Original content should be preserved (we don't truncate existing files)
        let content = fs::read(&file_path).expect("read");
        assert_eq!(
            content,
            b"existing content with different length",
            "original content should be preserved"
        );
    }

    #[test]
    fn error_includes_path_context() {
        // Test that errors include the path for debugging
        // We can't easily trigger a real error in tests, but we can verify
        // the error types include path information

        let err = DiskError::CreateFile {
            path: PathBuf::from("/some/path/file.txt"),
            source: std::io::Error::new(std::io::ErrorKind::PermissionDenied, "test"),
        };

        let msg = err.to_string();
        assert!(
            msg.contains("/some/path/file.txt"),
            "error message should include path"
        );
    }

    #[test]
    fn empty_file_list_is_valid() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        let files: Vec<FileInfo> = vec![];

        // Should succeed with empty list
        create_output_files(output_dir, &files).expect("create files");
    }
}
@

The tests cover the main scenarios:

\begin{itemize}
\item \textbf{Basic creation}: Single file with correct size
\item \textbf{Directory creation}: Nested directories are created automatically
\item \textbf{Multiple files}: Batch creation works correctly
\item \textbf{Idempotency}: Existing files are not modified
\item \textbf{Zero-length files}: Edge case handled correctly
\item \textbf{Sparse allocation}: Large file doesn't consume excessive disk space
\item \textbf{Error context}: Error messages include the problematic path
\end{itemize}

The sparse file test creates a 1 GB file to verify that sparse allocation works.
On systems with sparse file support, this completes instantly despite the large
size. The test doesn't verify actual disk usage (which varies by filesystem)
but confirms the API works correctly.
