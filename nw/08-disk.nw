        let mut in_progress = InProgressPiece::new(0, piece_size);
        assert_eq!(in_progress.num_blocks(), 3);

        // Receive blocks OUT OF ORDER: block 2, then block 0, then block 1
        let block0 = &piece_data[0..BLOCK_SIZE as usize];
