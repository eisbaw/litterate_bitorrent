    #[test]
    fn map_piece_spanning_two_files() {
        // Two files of 100 bytes each (total 200)
        // Piece length 64 bytes
        // Piece 1 spans bytes 64-127 in virtual stream
        //   - File 0 ends at byte 99, so piece 1 uses bytes 64-99 (36 bytes)
        //   - File 1 starts at byte 100, so piece 1 uses bytes 100-127 (28 bytes at offset 0)
        let files = vec![
            FileInfo { length: 100, path: PathBuf::from("a.bin") },
            FileInfo { length: 100, path: PathBuf::from("b.bin") },
        ];

        let slices = map_piece_to_files(1, 64, 200, &files);

        assert_eq!(slices.len(), 2, "piece should span two files");

        // First slice: end of file 0
        assert_eq!(slices[0].file_index, 0);
        assert_eq!(slices[0].file_offset, 64);
        assert_eq!(slices[0].length, 36);

        // Second slice: beginning of file 1
        assert_eq!(slices[1].file_index, 1);
        assert_eq!(slices[1].file_offset, 0);
        assert_eq!(slices[1].length, 28);
    }

