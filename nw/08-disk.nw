    /// Integration test: Hash mismatch detection with corrupted data.
    ///
    /// Tests AC#7: verify that corrupted data fails hash verification.
    #[test]
    fn integration_hash_mismatch_detection() {
        // Create valid piece data
        let piece_data: Vec<u8> = (0..100u8).collect();
        let valid_hash = compute_sha1(&piece_data);

        // Assemble the piece
        let mut in_progress = InProgressPiece::new(0, 100);
        in_progress.receive_block(0, &piece_data).expect("receive");
        assert!(in_progress.is_complete());

        // Verification should succeed with correct hash
        verify_piece(0, in_progress.data(), &valid_hash).expect("valid hash should pass");

        // Now create corrupted data
        let mut corrupted_data = piece_data.clone();
        corrupted_data[50] ^= 0xFF; // Flip bits in middle byte

        let mut in_progress_bad = InProgressPiece::new(0, 100);
        in_progress_bad.receive_block(0, &corrupted_data).expect("receive corrupted");

        // Verification should FAIL with the original hash
        let result = verify_piece(0, in_progress_bad.data(), &valid_hash);
        assert!(result.is_err(), "corrupted data should fail verification");

        // Verify the error contains useful information
        let err = result.unwrap_err();
        let err_msg = err.to_string();
        assert!(err_msg.contains("hash mismatch"), "error should mention hash mismatch");
        assert!(err_msg.contains("piece 0"), "error should mention piece index");
    }

