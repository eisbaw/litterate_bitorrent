    #[test]
    fn integration_multiblock_piece_out_of_order() {
        let temp = tempdir().expect("create temp dir");
        let output_dir = temp.path();

        // Single file torrent, piece larger than BLOCK_SIZE
        let piece_size: u32 = 40000; // 3 blocks: 16384 + 16384 + 7232
        let files = vec![FileInfo {
            length: piece_size as u64,
            path: PathBuf::from("test.bin"),
        }];

        create_output_files(output_dir, &files).expect("create files");

        // Create test data with recognizable pattern
        let piece_data: Vec<u8> = (0..piece_size).map(|i| (i % 256) as u8).collect();
        let expected_hash = compute_sha1(&piece_data);

